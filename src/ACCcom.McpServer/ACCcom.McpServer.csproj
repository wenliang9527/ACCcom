<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ACCcom.McpServer</RootNamespace>
    <!-- R2R precompiles core code paths: the stdio server starts in ~1s and
         keeps JIT code pages out of the working set. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ACCcom.Core\ACCcom.Core.csproj" />
  </ItemGroup>

</Project>
