<Window x:Class="ACCcom.TriggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ACCcom.Controls"
        xmlns:local="clr-namespace:ACCcom"
        xmlns:models="clr-namespace:ACCcom.Core.Models;assembly=ACCcom.Core"
        Title="{Binding [TriggerWindow.Title], Source={x:Static local:LanguageManager.Instance}}"
        Height="460" Width="760"
        MinHeight="360" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource BgBaseBrush}"
        Style="{StaticResource WindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ChromeTitleBar Grid.Row="0" x:Name="TitleBar"
                 Title="{Binding [TriggerWindow.Title], Source={x:Static local:LanguageManager.Instance}}" />

        <DataGrid Grid.Row="1" x:Name="RulesGrid"
                  ItemsSource="{Binding TriggerRules}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" CanUserResizeRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource DividerBrush}"
                  Background="Transparent"
                  RowBackground="Transparent"
                  AlternatingRowBackground="Transparent"
                  Foreground="{DynamicResource InkPrimaryBrush}"
                  BorderThickness="0"
                  Margin="10,10,10,0"
                  RowHeight="26"
                  FontSize="{StaticResource FontSizeBodyLarge}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding [TriggerWindow.ColName], Source={x:Static local:LanguageManager.Instance}}" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="{Binding [TriggerWindow.ColPattern], Source={x:Static local:LanguageManager.Instance}}" Binding="{Binding Pattern}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="{Binding [TriggerWindow.ColMatchMode], Source={x:Static local:LanguageManager.Instance}}" Binding="{Binding MatchMode}" Width="80" IsReadOnly="True" />
                <DataGridTextColumn Header="{Binding [TriggerWindow.ColDirection], Source={x:Static local:LanguageManager.Instance}}" Binding="{Binding Direction}" Width="60" IsReadOnly="True" />
                <DataGridTextColumn Header="HEX" Binding="{Binding MatchHex}" Width="45" IsReadOnly="True" />
                <DataGridTextColumn Header="{Binding [TriggerWindow.ColAction], Source={x:Static local:LanguageManager.Instance}}" Binding="{Binding Action}" Width="110" IsReadOnly="True" />
                <DataGridTextColumn Header="{Binding [TriggerWindow.ColParameter], Source={x:Static local:LanguageManager.Instance}}" Binding="{Binding ActionParameter}" Width="*" IsReadOnly="True" />
                <DataGridCheckBoxColumn Header="{Binding [TriggerWindow.ColEnabled], Source={x:Static local:LanguageManager.Instance}}" Binding="{Binding Enabled}" Width="50" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <EventSetter Event="MouseDoubleClick" Handler="Row_DoubleClick" />
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
        <TextBlock Grid.Row="1">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyListText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems, ElementName=RulesGrid}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <DockPanel Grid.Row="2" Margin="10,8,10,10">
            <Button DockPanel.Dock="Left" Content="{Binding [TriggerWindow.Add], Source={x:Static local:LanguageManager.Instance}}"
                    Style="{StaticResource OutlineButton}" Command="{Binding AddTriggerCommand}" />
            <Button DockPanel.Dock="Left" Content="{Binding [TriggerWindow.Edit], Source={x:Static local:LanguageManager.Instance}}"
                    Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Click="Edit_Click" />
            <Button DockPanel.Dock="Left" Content="{Binding [TriggerWindow.Delete], Source={x:Static local:LanguageManager.Instance}}"
                    Style="{StaticResource OutlineButton}" Margin="6,0,0,0"
                    Command="{Binding DeleteTriggerCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=RulesGrid}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding [TriggerWindow.Load], Source={x:Static local:LanguageManager.Instance}}"
                        Style="{StaticResource OutlineButton}" Command="{Binding LoadTriggersCommand}" Margin="0,0,6,0" />
                <Button Content="{Binding [TriggerWindow.Save], Source={x:Static local:LanguageManager.Instance}}"
                        Style="{StaticResource PrimaryButton}" Command="{Binding SaveTriggersCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>