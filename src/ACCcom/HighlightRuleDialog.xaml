<Window x:Class="ACCcom.HighlightRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ACCcom"
        xmlns:services="clr-namespace:ACCcom.Core.Services;assembly=ACCcom.Core"
        Title="{Binding [HighlightDialog.Title], Source={x:Static local:LanguageManager.Instance}}"
        Width="440" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource BgBaseBrush}"
        Style="{StaticResource WindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource BgSurfaceBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" x:Name="TitleText"
                           Text="{Binding [HighlightDialog.Title], Source={x:Static local:LanguageManager.Instance}}"
                           Foreground="{DynamicResource InkSecondaryBrush}"
                           FontSize="12" FontWeight="Medium"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="&#x2715;" Style="{StaticResource TitleBarCloseButton}" FontSize="11" Width="46" Height="28" Click="TitleBarClose_Click" ToolTip="关闭" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="{Binding [HighlightDialog.Name], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,0,4" />
                <TextBox x:Name="NameBox" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock Text="{Binding [HighlightDialog.Pattern], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,0,4" />
                <TextBox x:Name="PatternBox" FontFamily="Consolas" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [HighlightDialog.MatchType], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,6,0" />
                    <ComboBox x:Name="MatchTypeBox" Width="120"
                              ItemsSource="{x:Static local:HighlightRuleDialog.MatchTypes}"
                              DisplayMemberPath="Name" SelectedValuePath="Value" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [HighlightDialog.Direction], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,6,0" />
                    <ComboBox x:Name="DirectionBox" Width="80"
                              ItemsSource="{x:Static local:HighlightRuleDialog.Directions}"
                              DisplayMemberPath="Name" SelectedValuePath="Value" />
                </StackPanel>
                <CheckBox x:Name="MatchHexBox" Content="HEX"
                          ToolTip="{Binding [HighlightDialog.MatchHexTip], Source={x:Static local:LanguageManager.Instance}}" />
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                <TextBlock Text="{Binding [HighlightDialog.Color], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,6,0" />
                <ComboBox x:Name="ColorBox" Width="160"
                          ItemsSource="{x:Static local:HighlightRuleDialog.ColorPresets}"
                          DisplayMemberPath="Name" SelectedValuePath="Value" />
                <Border x:Name="ColorSwatch" Width="28" Height="20" CornerRadius="3" Margin="8,0,0,0"
                        BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" />
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                <TextBlock Text="{Binding [HighlightDialog.Priority], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,6,0" />
                <TextBox x:Name="PriorityBox" Style="{StaticResource NumericBox}" Width="64" />
                <TextBlock Text="{Binding [HighlightDialog.PriorityHint], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="10,0,0,0" />
            </StackPanel>

            <CheckBox Grid.Row="5" x:Name="EnabledBox"
                      Content="{Binding [HighlightDialog.Enabled], Source={x:Static local:LanguageManager.Instance}}" />

            <TextBlock Grid.Row="7" x:Name="ValidationText"
                       Foreground="{DynamicResource RedErrorBrush}" FontSize="11" VerticalAlignment="Top" />

            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding [Button.Cancel], Source={x:Static local:LanguageManager.Instance}}"
                        Style="{StaticResource OutlineButton}" Width="60" Margin="0,0,8,0"
                        Click="Cancel_Click" />
                <Button x:Name="OkButton" Content="{Binding [Button.Save], Source={x:Static local:LanguageManager.Instance}}"
                        Style="{StaticResource PrimaryButton}" Width="60"
                        Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>