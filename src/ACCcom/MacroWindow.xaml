<Window x:Class="ACCcom.MacroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ACCcom"
        xmlns:models="clr-namespace:ACCcom.Core.Models;assembly=ACCcom.Core"
        Title="{Binding [MacroWindow.Title], Source={x:Static local:LanguageManager.Instance}}"
        Height="520" Width="860"
        MinHeight="380" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource BgBaseBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource BgSurfaceBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding [MacroWindow.Title], Source={x:Static local:LanguageManager.Instance}}"
                           Foreground="{DynamicResource InkSecondaryBrush}"
                           FontSize="12" FontWeight="Medium"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding MacroStatus}" FontSize="10"
                           Foreground="{DynamicResource InkTertiaryBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="&#x2500;" Style="{StaticResource TitleBarButton}" FontSize="10" Width="46" Height="32" Click="TitleBarMin_Click" />
                    <Button Content="&#x25A1;" Style="{StaticResource TitleBarButton}" FontSize="9" Width="46" Height="32" Click="TitleBarMax_Click" />
                    <Button Content="&#x2715;" Style="{StaticResource TitleBarCloseButton}" FontSize="11" Width="46" Height="32" Click="TitleBarClose_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Macros (left) / steps (right) -->
        <Grid Grid.Row="1" Margin="10,10,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.42*" MinWidth="250" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="0.58*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- Macro list: in-place editable Name / Description / repeat -->
            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Macros}"
                      SelectedItem="{Binding SelectedMacro}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="False" CanUserResizeRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource DividerBrush}"
                      Background="Transparent"
                      RowBackground="Transparent"
                      AlternatingRowBackground="Transparent"
                      Foreground="{DynamicResource InkPrimaryBrush}"
                      BorderThickness="0"
                      RowHeight="26"
                      FontSize="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding [MacroWindow.ColName], Source={x:Static local:LanguageManager.Instance}}" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="{Binding [MacroWindow.ColDescription], Source={x:Static local:LanguageManager.Instance}}" Binding="{Binding Description}" Width="*" />
                    <DataGridTextColumn Header="{Binding [MacroWindow.ColRepeat], Source={x:Static local:LanguageManager.Instance}}" Binding="{Binding RepeatCount}" Width="52" />
                    <DataGridTextColumn Header="{Binding [MacroWindow.ColRepeatDelay], Source={x:Static local:LanguageManager.Instance}}" Binding="{Binding RepeatDelayMs}" Width="78" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Steps of the selected macro: command / hex / delay / wait -->
            <DataGrid Grid.Column="2"
                      ItemsSource="{Binding SelectedMacro.Steps}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="True" CanUserDeleteRows="True"
                      CanUserReorderColumns="False" CanUserResizeRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource DividerBrush}"
                      Background="Transparent"
                      RowBackground="Transparent"
                      AlternatingRowBackground="Transparent"
                      Foreground="{DynamicResource InkPrimaryBrush}"
                      BorderThickness="0"
                      RowHeight="26"
                      FontSize="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding [MacroWindow.ColCommand], Source={x:Static local:LanguageManager.Instance}}" Binding="{Binding Command}" Width="*" />
                    <DataGridCheckBoxColumn Header="{Binding [MacroWindow.ColHex], Source={x:Static local:LanguageManager.Instance}}" Binding="{Binding IsHex}" Width="45" />
                    <DataGridTextColumn Header="{Binding [MacroWindow.ColDelay], Source={x:Static local:LanguageManager.Instance}}" Binding="{Binding DelayMs}" Width="70" />
                    <DataGridTextColumn Header="{Binding [MacroWindow.ColWaitFor], Source={x:Static local:LanguageManager.Instance}}" Binding="{Binding WaitFor}" Width="90" />
                    <DataGridTextColumn Header="{Binding [MacroWindow.ColWaitTimeout], Source={x:Static local:LanguageManager.Instance}}" Binding="{Binding WaitTimeoutMs}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <DockPanel Grid.Row="2" Margin="10,0,10,10">
            <Button DockPanel.Dock="Left" Content="{Binding [MacroWindow.NewMacro], Source={x:Static local:LanguageManager.Instance}}"
                    Style="{StaticResource OutlineButton}" Command="{Binding AddMacroCommand}" />
            <Button DockPanel.Dock="Left" Content="{Binding [MacroWindow.DeleteMacro], Source={x:Static local:LanguageManager.Instance}}"
                    Style="{StaticResource OutlineButton}" Margin="6,0,0,0"
                    Command="{Binding DeleteMacroCommand}" />
            <Button DockPanel.Dock="Left" Content="{Binding [MacroWindow.AddStep], Source={x:Static local:LanguageManager.Instance}}"
                    Style="{StaticResource OutlineButton}" Margin="16,0,0,0"
                    Command="{Binding AddMacroStepCommand}" />
            <Button DockPanel.Dock="Left" Content="{Binding [MacroWindow.RemoveStep], Source={x:Static local:LanguageManager.Instance}}"
                    Style="{StaticResource OutlineButton}" Margin="6,0,0,0"
                    Command="{Binding RemoveMacroStepCommand}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding [Button.Import], Source={x:Static local:LanguageManager.Instance}}"
                        Style="{StaticResource OutlineButton}" Command="{Binding LoadMacroCommand}" Margin="0,0,6,0" />
                <Button Content="{Binding [Button.Save], Source={x:Static local:LanguageManager.Instance}}"
                        Style="{StaticResource OutlineButton}" Command="{Binding SaveMacroCommand}" Margin="0,0,6,0" />
                <Button Content="{Binding [Button.Stop], Source={x:Static local:LanguageManager.Instance}}"
                        Style="{StaticResource OutlineButton}" Command="{Binding StopMacroCommand}" Margin="0,0,6,0" />
                <Button Content="{Binding [Button.Run], Source={x:Static local:LanguageManager.Instance}}"
                        Style="{StaticResource PrimaryButton}" Command="{Binding RunMacroCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>