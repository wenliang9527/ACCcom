<Window x:Class="ACCcom.ThemeGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ACCcom.Controls"
        xmlns:local="clr-namespace:ACCcom"
        Title="ThemeGallery"
        Width="800" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource BgBaseBrush}"
        Style="{StaticResource WindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <controls:ChromeTitleBar Grid.Row="0" x:Name="TitleBar"
                 ShowMinMax="False"
                 Title="{Binding [Theme.GalleryTitle], Source={x:Static local:LanguageManager.Instance}}" />

        <!-- Gallery -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="8" CornerRadius="10" Cursor="Hand"
                                BorderThickness="1" Padding="0,0,0,10">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{Binding InkSoft}" Opacity="0.25" />
                            </Border.BorderBrush>
                            <Border.Background>
                                <SolidColorBrush Color="{Binding Surface}" />
                            </Border.Background>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding Id}" />
                            </Border.InputBindings>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderThickness" Value="2" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="BorderThickness" Value="2" />
                                            <Setter Property="BorderBrush">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="{Binding Accent}" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <!-- Live preview mock rendered in the theme's own colors -->
                                <Border Height="76" CornerRadius="10,10,0,0" Padding="12,10">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding Bg}" />
                                    </Border.Background>
                                    <StackPanel>
                                        <Border Height="10" Width="64" CornerRadius="2" HorizontalAlignment="Left" Margin="0,0,0,8">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding Accent}" />
                                            </Border.Background>
                                        </Border>
                                        <Border Height="7" CornerRadius="2" Margin="0,0,24,5" Opacity="0.9">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding Ink}" />
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Height="7" Width="56" CornerRadius="2" Margin="0,0,6,0">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding Good}" />
                                                </Border.Background>
                                            </Border>
                                            <Border Height="7" Width="36" CornerRadius="2">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding Bad}" />
                                                </Border.Background>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <!-- Name + current badge. Text uses the CANDIDATE
                                     theme's ink (the card background is the
                                     candidate's surface), not the active theme's —
                                     otherwise a dark card viewed under the light
                                     theme would render near-white text on near-black. -->
                                <StackPanel Orientation="Horizontal" Margin="12,8,12,0" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding Accent}" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Text="{Binding Name}">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{Binding Ink}" />
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <Border CornerRadius="8" BorderThickness="1" Margin="8,0,0,0" Padding="7,1"
                                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="{Binding Accent}" />
                                        </Border.BorderBrush>
                                        <TextBlock FontSize="{StaticResource FontSizeCaption}" VerticalAlignment="Center"
                                                   Text="{Binding [Theme.Current], Source={x:Static local:LanguageManager.Instance}}">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{Binding InkSoft}" />
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="12,4,12,0" FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap"
                                           Text="{Binding Description}">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush Color="{Binding InkSoft}" />
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
