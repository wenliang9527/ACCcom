<Window x:Class="ACCcom.VirtualSerialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ACCcom"
        xmlns:models="clr-namespace:ACCcom.Core.Models;assembly=ACCcom.Core"
        Title="{Binding [VirtualSerial.Title], Source={x:Static local:LanguageManager.Instance}}"
        Height="640" Width="720"
        MinHeight="480" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource BgBaseBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource BgSurfaceBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding [VirtualSerial.Title], Source={x:Static local:LanguageManager.Instance}}"
                           Foreground="{DynamicResource InkSecondaryBrush}"
                           FontSize="12" FontWeight="Medium"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="&#x2500;" Style="{StaticResource TitleBarButton}" FontSize="10" Width="46" Height="32" Click="TitleBarMin_Click" />
                    <Button Content="&#x25A1;" Style="{StaticResource TitleBarButton}" FontSize="9" Width="46" Height="32" Click="TitleBarMax_Click" />
                    <Button Content="&#x2715;" Style="{StaticResource TitleBarCloseButton}" FontSize="11" Width="46" Height="32" Click="TitleBarClose_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Connection controls -->
        <Grid Grid.Row="1" Margin="12,8,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding [VirtualSerial.Port], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,4,0" />
            <TextBox Grid.Column="1" Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="4,1" Margin="0,0,12,0" />
            <TextBlock Grid.Column="2" Text="{Binding [VirtualSerial.Baud], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,4,0" />
            <TextBox Grid.Column="3" Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericBox}" Width="70" Margin="0,0,12,0" />
            <Button Grid.Column="4" Content="{Binding [VirtualSerial.Open], Source={x:Static local:LanguageManager.Instance}}"
                    Style="{StaticResource PrimaryButton}" Padding="10,0" Height="24" Command="{Binding OpenCommand}" />
            <Button Grid.Column="5" Content="{Binding [VirtualSerial.Close], Source={x:Static local:LanguageManager.Instance}}"
                    Style="{StaticResource OutlineButton}" Padding="10,0" Height="24" Margin="6,0,0,0" Command="{Binding CloseCommand}" />
            <Button Grid.Column="6" Content="{Binding [VirtualSerial.Clear], Source={x:Static local:LanguageManager.Instance}}"
                    Style="{StaticResource OutlineButton}" Padding="10,0" Height="24" Margin="6,0,0,0" Command="{Binding ClearCommand}" />
        </Grid>

        <!-- Inject RX -->
        <Grid Grid.Row="2" Margin="12,4,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding [VirtualSerial.InjectRx], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,4,0" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding RxHexInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" Padding="4,2"
                     Margin="0,0,8,0" VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Content="{Binding [VirtualSerial.Inject], Source={x:Static local:LanguageManager.Instance}}"
                    Style="{StaticResource OutlineButton}" Padding="10,0" Height="24" Command="{Binding InjectRxCommand}" />
        </Grid>

        <!-- Send TX -->
        <Grid Grid.Row="3" Margin="12,4,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                <TextBlock DockPanel.Dock="Left" Text="{Binding [VirtualSerial.TxSend], Source={x:Static local:LanguageManager.Instance}}"
                           Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="{Binding [VirtualSerial.Send], Source={x:Static local:LanguageManager.Instance}}"
                        Style="{StaticResource OutlineButton}" Padding="10,0" Height="24" Command="{Binding SendCommand}" />
                <CheckBox DockPanel.Dock="Right" Content="HEX" IsChecked="{Binding IsHexSend}" FontSize="11"
                          Foreground="{DynamicResource InkSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
            </DockPanel>
            <TextBox Grid.Row="1" Text="{Binding TxInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" Padding="4,2"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        </Grid>

        <!-- Direction log -->
        <Grid Grid.Row="4" Margin="12,4,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding [VirtualSerial.Log], Source={x:Static local:LanguageManager.Instance}}"
                       Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Entries}" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.IsDeferredScrollingEnabled="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat=HH:mm:ss}" Foreground="{DynamicResource InkSecondaryBrush}" FontSize="11" />
                            <TextBlock Grid.Column="1" FontWeight="Bold" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="TX" />
                                        <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Direction}" Value="RX">
                                                <Setter Property="Text" Value="RX" />
                                                <Setter Property="Foreground" Value="{DynamicResource StatusBlueBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="2" Text="{Binding RawHex}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
