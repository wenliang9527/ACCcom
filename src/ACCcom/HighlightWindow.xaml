<Window x:Class="ACCcom.HighlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ACCcom.Controls"
        xmlns:local="clr-namespace:ACCcom"
        xmlns:services="clr-namespace:ACCcom.Core.Services;assembly=ACCcom.Core"
        Title="{Binding [HighlightWindow.Title], Source={x:Static local:LanguageManager.Instance}}"
        Height="440" Width="600"
        MinHeight="360" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource BgBaseBrush}"
        Style="{StaticResource WindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ChromeTitleBar Grid.Row="0" x:Name="TitleBar"
                 Title="{Binding [HighlightWindow.Title], Source={x:Static local:LanguageManager.Instance}}" />

        <DataGrid Grid.Row="1" x:Name="RulesGrid"
                  ItemsSource="{Binding Rules}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" CanUserResizeRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource DividerBrush}"
                  Background="Transparent"
                  RowBackground="Transparent"
                  AlternatingRowBackground="Transparent"
                  Foreground="{DynamicResource InkPrimaryBrush}"
                  BorderThickness="0"
                  Margin="10,10,10,0"
                  RowHeight="26"
                  FontSize="{StaticResource FontSizeBodyLarge}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding [HighlightGrid.Name], Source={x:Static local:LanguageManager.Instance}}"     Binding="{Binding Name}"     Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="{Binding [HighlightGrid.Pattern], Source={x:Static local:LanguageManager.Instance}}"  Binding="{Binding Pattern}"  Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="{Binding [HighlightGrid.Match], Source={x:Static local:LanguageManager.Instance}}"    Binding="{Binding MatchType}" Width="80" IsReadOnly="True" />
                <DataGridTextColumn Header="{Binding [HighlightGrid.Dir], Source={x:Static local:LanguageManager.Instance}}"      Binding="{Binding Direction}" Width="60" IsReadOnly="True" />
                <DataGridTextColumn Header="{Binding [HighlightGrid.Hex], Source={x:Static local:LanguageManager.Instance}}"      Binding="{Binding MatchHex}" Width="50" IsReadOnly="True" />
                <DataGridTextColumn Header="{Binding [HighlightGrid.Priority], Source={x:Static local:LanguageManager.Instance}}" Binding="{Binding Priority}" Width="70" IsReadOnly="True" />
                <DataGridTemplateColumn Header="{Binding [HighlightGrid.Color], Source={x:Static local:LanguageManager.Instance}}" Width="100" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Margin="0,0,6,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Width" Value="14" />
                                            <Setter Property="Height" Value="14" />
                                            <Setter Property="RadiusX" Value="3" />
                                            <Setter Property="RadiusY" Value="3" />
                                            <Setter Property="Fill" Value="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                            <Setter Property="Stroke" Value="{DynamicResource BorderLightBrush}" />
                                            <Setter Property="StrokeThickness" Value="1" />
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <TextBlock Text="{Binding Color}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Header="{Binding [HighlightGrid.On], Source={x:Static local:LanguageManager.Instance}}" Binding="{Binding IsEnabled}" Width="40" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <EventSetter Event="MouseDoubleClick" Handler="Row_DoubleClick" />
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
        <TextBlock Grid.Row="1">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyListText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems, ElementName=RulesGrid}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <DockPanel Grid.Row="2" Margin="10,8,10,10">
            <Button DockPanel.Dock="Left" Content="{Binding [HighlightWindow.AddRule], Source={x:Static local:LanguageManager.Instance}}"
                    Style="{StaticResource OutlineButton}" Command="{Binding AddRuleCommand}" />
            <Button DockPanel.Dock="Left" Content="{Binding [HighlightWindow.EditRule], Source={x:Static local:LanguageManager.Instance}}"
                    Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Click="Edit_Click" />
            <Button DockPanel.Dock="Left" Content="{Binding [HighlightWindow.DeleteRule], Source={x:Static local:LanguageManager.Instance}}"
                    Style="{StaticResource OutlineButton}" Margin="6,0,0,0"
                    Command="{Binding DeleteRuleCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=RulesGrid}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding [HighlightWindow.Save], Source={x:Static local:LanguageManager.Instance}}"
                        Style="{StaticResource PrimaryButton}" Command="{Binding SaveRulesCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>