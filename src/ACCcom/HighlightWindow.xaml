<Window x:Class="ACCcom.HighlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ACCcom"
        xmlns:services="clr-namespace:ACCcom.Core.Services;assembly=ACCcom.Core"
        Title="{Binding [HighlightWindow.Title], Source={x:Static local:LanguageManager.Instance}}"
        Height="440" Width="600"
        MinHeight="360" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource BgBaseBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource BgSurfaceBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding [HighlightWindow.Title], Source={x:Static local:LanguageManager.Instance}}"
                           Foreground="{DynamicResource InkSecondaryBrush}"
                           FontSize="12" FontWeight="Medium"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="&#x2500;" Style="{StaticResource TitleBarButton}" FontSize="10" Width="46" Height="32" Click="TitleBarMin_Click" />
                    <Button Content="&#x25A1;" Style="{StaticResource TitleBarButton}" FontSize="9" Width="46" Height="32" Click="TitleBarMax_Click" />
                    <Button Content="&#x2715;" Style="{StaticResource TitleBarCloseButton}" FontSize="11" Width="46" Height="32" Click="TitleBarClose_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DataGrid Grid.Row="1" x:Name="RulesGrid"
                  ItemsSource="{Binding Rules}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" CanUserResizeRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource DividerBrush}"
                  Background="Transparent"
                  RowBackground="Transparent"
                  AlternatingRowBackground="Transparent"
                  Foreground="{DynamicResource InkPrimaryBrush}"
                  BorderThickness="0"
                  Margin="10,10,10,0"
                  RowHeight="26"
                  FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"     Binding="{Binding Name}"     Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Pattern"  Binding="{Binding Pattern}"  Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Match"    Binding="{Binding MatchType}" Width="80" IsReadOnly="True" />
                <DataGridTextColumn Header="Dir"      Binding="{Binding Direction}" Width="60" IsReadOnly="True" />
                <DataGridTextColumn Header="HEX"      Binding="{Binding MatchHex}" Width="50" IsReadOnly="True" />
                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="70" IsReadOnly="True" />
                <DataGridTemplateColumn Header="Color" Width="100" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Margin="0,0,6,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Width" Value="14" />
                                            <Setter Property="Height" Value="14" />
                                            <Setter Property="RadiusX" Value="3" />
                                            <Setter Property="RadiusY" Value="3" />
                                            <Setter Property="Fill" Value="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                            <Setter Property="Stroke" Value="{DynamicResource BorderLightBrush}" />
                                            <Setter Property="StrokeThickness" Value="1" />
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <TextBlock Text="{Binding Color}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled}" Width="40" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <EventSetter Event="MouseDoubleClick" Handler="Row_DoubleClick" />
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
        <TextBlock Grid.Row="1" Visibility="Collapsed">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyListText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems, ElementName=RulesGrid}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <DockPanel Grid.Row="2" Margin="10,8,10,10">
            <Button DockPanel.Dock="Left" Content="{Binding [HighlightWindow.AddRule], Source={x:Static local:LanguageManager.Instance}}"
                    Style="{StaticResource OutlineButton}" Command="{Binding AddRuleCommand}" />
            <Button DockPanel.Dock="Left" Content="{Binding [HighlightWindow.EditRule], Source={x:Static local:LanguageManager.Instance}}"
                    Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Click="Edit_Click" />
            <Button DockPanel.Dock="Left" Content="{Binding [HighlightWindow.DeleteRule], Source={x:Static local:LanguageManager.Instance}}"
                    Style="{StaticResource OutlineButton}" Margin="6,0,0,0"
                    Command="{Binding DeleteRuleCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=RulesGrid}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding [HighlightWindow.Save], Source={x:Static local:LanguageManager.Instance}}"
                        Style="{StaticResource PrimaryButton}" Command="{Binding SaveRulesCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>