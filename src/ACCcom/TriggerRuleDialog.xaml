<Window x:Class="ACCcom.TriggerRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ACCcom"
        xmlns:models="clr-namespace:ACCcom.Core.Models;assembly=ACCcom.Core"
        Title="{Binding [TriggerDialog.Title], Source={x:Static local:LanguageManager.Instance}}"
        Width="460" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource BgBaseBrush}"
        Style="{StaticResource WindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource BgSurfaceBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" x:Name="TitleText"
                           Text="{Binding [TriggerDialog.Title], Source={x:Static local:LanguageManager.Instance}}"
                           Foreground="{DynamicResource InkSecondaryBrush}"
                           FontSize="12" FontWeight="Medium"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="&#x2715;" Style="{StaticResource TitleBarCloseButton}" FontSize="11" Width="46" Height="28" Click="TitleBarClose_Click" ToolTip="{Binding [TitleBar.Close], Source={x:Static local:LanguageManager.Instance}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="{Binding [TriggerDialog.Name], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,0,4" />
                <TextBox x:Name="NameBox" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock Text="{Binding [TriggerDialog.Pattern], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,0,4" />
                <TextBox x:Name="PatternBox" FontFamily="Consolas" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [TriggerDialog.MatchMode], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,6,0" />
                    <ComboBox x:Name="MatchModeBox" Width="110"
                              ItemsSource="{x:Static local:TriggerRuleDialog.MatchModes}"
                              DisplayMemberPath="Name" SelectedValuePath="Value" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [TriggerDialog.Direction], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,6,0" />
                    <ComboBox x:Name="DirectionBox" Width="80"
                              ItemsSource="{x:Static local:TriggerRuleDialog.Directions}"
                              DisplayMemberPath="Name" SelectedValuePath="Value" />
                </StackPanel>
                <CheckBox x:Name="MatchHexBox" Content="HEX" VerticalAlignment="Center"
                          ToolTip="{Binding [TriggerDialog.MatchHexTip], Source={x:Static local:LanguageManager.Instance}}" />
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{Binding [TriggerDialog.Action], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,6,0" VerticalAlignment="Center" />
                <ComboBox x:Name="ActionBox" Width="150"
                          ItemsSource="{x:Static local:TriggerRuleDialog.Actions}"
                          DisplayMemberPath="Name" SelectedValuePath="Value"
                          SelectionChanged="ActionBox_SelectionChanged" />
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,0,0,8">
                <TextBlock x:Name="ActionParameterLabel" Text="{Binding [TriggerDialog.ActionParameter], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,0,4" />
                <TextBox x:Name="ActionParameterBox" FontFamily="Consolas" />
            </StackPanel>

            <CheckBox Grid.Row="5" x:Name="EnabledBox"
                      Content="{Binding [TriggerDialog.Enabled], Source={x:Static local:LanguageManager.Instance}}" />

            <TextBlock Grid.Row="7" x:Name="ValidationText"
                       Foreground="{DynamicResource RedErrorBrush}" FontSize="11" VerticalAlignment="Top" TextWrapping="Wrap" />

            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding [Button.Cancel], Source={x:Static local:LanguageManager.Instance}}"
                        Style="{StaticResource OutlineButton}" Width="60" Margin="0,0,8,0"
                        Click="Cancel_Click" />
                <Button x:Name="OkButton" Content="{Binding [TriggerDialog.Save], Source={x:Static local:LanguageManager.Instance}}"
                        Style="{StaticResource PrimaryButton}" Width="60"
                        Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>