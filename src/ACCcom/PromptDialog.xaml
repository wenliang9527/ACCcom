<Window x:Class="ACCcom.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ACCcom"
        Title="ACCCOM"
        Width="380" Height="170"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource BgBaseBrush}"
        Style="{StaticResource WindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource BgSurfaceBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" x:Name="TitleText" Text=""
                           Foreground="{DynamicResource InkSecondaryBrush}"
                           FontSize="12" FontWeight="Medium"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="&#x2715;" Style="{StaticResource TitleBarCloseButton}" FontSize="11" Width="46" Height="28" Click="Cancel_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="16">
            <TextBlock x:Name="MessageText" Text="" Style="{StaticResource Label}" Margin="0,0,0,6" />
            <TextBox x:Name="InputBox" Margin="0,0,0,12" KeyDown="InputBox_KeyDown" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding [Button.Cancel], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource OutlineButton}" Width="60" Margin="0,0,8,0"
                        Click="Cancel_Click" />
                <Button Content="{Binding [Button.OK], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource PrimaryButton}" Width="60"
                        Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
