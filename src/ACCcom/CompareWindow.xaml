<Window x:Class="ACCcom.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ACCcom"
        Title="{Binding [CompareWindow.Title], Source={x:Static local:LanguageManager.Instance}}" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource BgBaseBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource BgSurfaceBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding [CompareWindow.Title], Source={x:Static local:LanguageManager.Instance}}"
                           Foreground="{DynamicResource InkSecondaryBrush}"
                           FontSize="12" FontWeight="Medium"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="&#x2500;" Style="{StaticResource TitleBarButton}" FontSize="10" Width="46" Height="32" Click="TitleBarMin_Click" ToolTip="最小化" />
                    <Button Content="&#x25A1;" Style="{StaticResource TitleBarButton}" FontSize="9" Width="46" Height="32" Click="TitleBarMax_Click" ToolTip="最大化" />
                    <Button Content="&#x2715;" Style="{StaticResource TitleBarCloseButton}" FontSize="11" Width="46" Height="32" Click="TitleBarClose_Click" ToolTip="关闭" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <!-- File selection -->
        <Border Grid.Row="0" Padding="10" Background="{DynamicResource BgSurfaceBrush}" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding [CompareWindow.FileA], Source={x:Static local:LanguageManager.Instance}}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource InkSecondaryBrush}" />
                    <TextBox x:Name="FileAPath" Width="300" IsReadOnly="True" />
                    <Button Content="{Binding [CompareWindow.Browse], Source={x:Static local:LanguageManager.Instance}}" Click="BrowseFileA_Click" Margin="6,0,0,0"
                            Style="{StaticResource OutlineButton}" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="CompareButton" Content="{Binding [CompareWindow.Compare], Source={x:Static local:LanguageManager.Instance}}" Click="Compare_Click" Margin="16,0"
                        Style="{StaticResource PrimaryButton}" Padding="20,4" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding [CompareWindow.FileB], Source={x:Static local:LanguageManager.Instance}}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource InkSecondaryBrush}" />
                    <TextBox x:Name="FileBPath" Width="300" IsReadOnly="True" />
                    <Button Content="{Binding [CompareWindow.Browse], Source={x:Static local:LanguageManager.Instance}}" Click="BrowseFileB_Click" Margin="6,0,0,0"
                            Style="{StaticResource OutlineButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Comparison results -->
        <Grid Grid.Row="1" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- File A list -->
            <Border Grid.Column="0" Background="{DynamicResource BgSurfaceBrush}" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding [CompareWindow.FileALabel], Source={x:Static local:LanguageManager.Instance}}" FontWeight="SemiBold" Margin="10,8"
                               Foreground="{DynamicResource StatusBlueBrush}" />
                    <ListBox x:Name="ListBoxA" Grid.Row="1"
                             FontFamily="Consolas" FontSize="12"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDiff}" Value="True">
                                                    <Setter Property="Background" Value="#28FFC800" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

            <!-- File B list -->
            <Border Grid.Column="2" Background="{DynamicResource BgSurfaceBrush}" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding [CompareWindow.FileBLabel], Source={x:Static local:LanguageManager.Instance}}" FontWeight="SemiBold" Margin="10,8"
                               Foreground="{DynamicResource StatusGreenBrush}" />
                    <ListBox x:Name="ListBoxB" Grid.Row="1"
                             FontFamily="Consolas" FontSize="12"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDiff}" Value="True">
                                                    <Setter Property="Background" Value="#28FFC800" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Summary -->
        <Border Grid.Row="2" Padding="10,6" Background="{DynamicResource BgSurfaceBrush}" CornerRadius="6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBox x:Name="SummaryText" Text="{Binding [CompareWindow.Hint], Source={x:Static local:LanguageManager.Instance}}"
                           FontSize="12" Foreground="{DynamicResource InkSecondaryBrush}"
                           IsReadOnly="True" IsTabStop="False" BorderThickness="0" Background="Transparent" Padding="0" />
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</Window>
