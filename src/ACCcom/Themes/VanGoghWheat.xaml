<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================== -->
    <!-- 梵高《麦田群鸦》1890                             -->
    <!-- 风暴蓝绿 + 麦金 + 乌鸦黑，戏剧张力                -->
    <!-- ============================================== -->

    <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="3"
                      Opacity="0.40" Color="#000000" Direction="270" />
    <DropShadowEffect x:Key="SubtleShadow" BlurRadius="8" ShadowDepth="1"
                      Opacity="0.25" Color="#000000" Direction="270" />

    <!-- Neutral base: crows over darkening wheat -->
    <Color x:Key="BgBase">#1B2220</Color>
    <Color x:Key="BgSurface">#232B28</Color>
    <Color x:Key="BgElevated">#2C3632</Color>
    <Color x:Key="BgHover">#36423C</Color>
    <Color x:Key="BgActive">#414F47</Color>
    <Color x:Key="BorderColor">#2E3934</Color>
    <Color x:Key="BorderLight">#46554D</Color>

    <!-- Text hierarchy: wheat cream -->
    <Color x:Key="InkPrimary">#EFEAD8</Color>
    <Color x:Key="InkSecondary">#B5B5A3</Color>
    <Color x:Key="InkTertiary">#8A8F7E</Color>

    <!-- Accent: ripe wheat gold under storm light -->
    <Color x:Key="Accent">#E0B33C</Color>
    <Color x:Key="AccentHover">#EBC463</Color>
    <Color x:Key="AccentPressed">#C69A28</Color>
    <Color x:Key="OnAccent">#1B1B1B</Color>

    <!-- Status semantics -->
    <Color x:Key="StatusBlue">#6E93A3</Color>
    <Color x:Key="StatusGray">#8A8F7E</Color>
    <Color x:Key="StatusGreen">#7FA05C</Color>
    <Color x:Key="StatusWarning">#E0B33C</Color>
    <Color x:Key="StatusError">#D36C57</Color>
    <!-- Danger button: deep red keeps white button text AA on every state -->
    <Color x:Key="BtnDanger">#C94E34</Color>
    <Color x:Key="BtnDangerHover">#BC4930</Color>
    <Color x:Key="BtnDangerPressed">#A43F2A</Color>

    <Color x:Key="StatusWarningBg">#18E0B33C</Color>
    <Color x:Key="StatusErrorBg">#18C75B4A</Color>

    <Color x:Key="ConnBadgeBg">#0D7FA05C</Color>
    <Color x:Key="ConnBadgeBorder">#337FA05C</Color>

    <Color x:Key="DiffMatchBg">#337FA05C</Color>
    <Color x:Key="DiffDiffBg">#33C75B4A</Color>
    <Color x:Key="CompareDiffBg">#33E0B33C</Color>

    <Color x:Key="SearchHighlight">#38EBC463</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource BgBase}" />
    <!-- Surface: thick impasto strokes, sky pressing down on the field -->
    <LinearGradientBrush x:Key="BgSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#262F2B" Offset="0" />
        <GradientStop Color="#212926" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BgElevatedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#303B35" Offset="0" />
        <GradientStop Color="#2A342F" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHover}" />
    <SolidColorBrush x:Key="BgActiveBrush" Color="{StaticResource BgActive}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}" />
    <SolidColorBrush x:Key="InkPrimaryBrush" Color="{StaticResource InkPrimary}" />
    <SolidColorBrush x:Key="InkSecondaryBrush" Color="{StaticResource InkSecondary}" />
    <SolidColorBrush x:Key="InkTertiaryBrush" Color="{StaticResource InkTertiary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressed}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccent}" />
    <SolidColorBrush x:Key="StatusBlueBrush" Color="{StaticResource StatusBlue}" />
    <SolidColorBrush x:Key="StatusGrayBrush" Color="{StaticResource StatusGray}" />
    <SolidColorBrush x:Key="StatusGreenBrush" Color="{StaticResource StatusGreen}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarning}" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusError}" />
    <SolidColorBrush x:Key="RedErrorBrush" Color="{StaticResource StatusError}" />
    <SolidColorBrush x:Key="BtnDangerBrush" Color="{StaticResource BtnDanger}" />
    <SolidColorBrush x:Key="BtnDangerHoverBrush" Color="{StaticResource BtnDangerHover}" />
    <SolidColorBrush x:Key="BtnDangerPressedBrush" Color="{StaticResource BtnDangerPressed}" />
    <SolidColorBrush x:Key="SearchHighlightBrush" Color="{StaticResource SearchHighlight}" />
    <SolidColorBrush x:Key="ConnBadgeBgBrush" Color="{StaticResource ConnBadgeBg}" />
    <SolidColorBrush x:Key="ConnBadgeBorderBrush" Color="{StaticResource ConnBadgeBorder}" />
    <SolidColorBrush x:Key="DiffMatchBgBrush" Color="{StaticResource DiffMatchBg}" />
    <SolidColorBrush x:Key="DiffDiffBgBrush" Color="{StaticResource DiffDiffBg}" />
    <SolidColorBrush x:Key="CompareDiffBgBrush" Color="{StaticResource CompareDiffBg}" />

    <SolidColorBrush x:Key="DividerBrush" Color="#2E3934" />

    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#46554D" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#56655D" />
    <SolidColorBrush x:Key="ScrollThumbPressBrush" Color="#66756D" />

    <!-- ============================================== -->
    <!-- Signature texture: 麦穗纹 (wheat ear)            -->
    <!-- Stem + chevron grains, impasto diagonal strokes -->
    <!-- ============================================== -->
    <DrawingBrush x:Key="CardTextureBrush" TileMode="Tile" Viewport="0,0,68,60"
                  ViewportUnits="Absolute" Opacity="0.06">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <!-- wheat stem, slightly bowed -->
                <GeometryDrawing Geometry="M34,54 C32,44 36,32 34,18">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#B99B3F" Thickness="1.1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- grain pairs in chevron rows (awns of the ear) -->
                <GeometryDrawing Geometry="M34,46 L25,40 M34,46 L43,40">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#D9B44A" Thickness="1.2" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M35,36 L26,30 M35,36 L44,30">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#D9B44A" Thickness="1.2" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M34,26 L25,20 M34,26 L43,20">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#C9A63F" Thickness="1.1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- ear tip -->
                <GeometryDrawing Geometry="M34,18 L28,12 M34,18 L40,12">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#C9A63F" Thickness="1.1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- storm-wind impasto dashes filling the field -->
                <GeometryDrawing Geometry="M6,52 L16,38">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#7FA05C" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M54,50 L62,40">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#6E93A3" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- a crow far off -->
                <GeometryDrawing Geometry="M56,12 Q58.4,9.2 60.8,12 Q58.4,10.8 56,12 Z">
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#14100E" />
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
