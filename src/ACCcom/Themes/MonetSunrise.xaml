<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================== -->
    <!-- Effects                                       -->
    <!-- ============================================== -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="2"
                      Opacity="0.07" Color="#1A2438" Direction="270" />
    <DropShadowEffect x:Key="SubtleShadow" BlurRadius="8" ShadowDepth="1"
                      Opacity="0.05" Color="#1A2438" Direction="270" />

    <!-- ============================================== -->
    <!-- 莫奈《日出·印象》1872 — 亮色                    -->
    <!-- 晨雾纸白 + 雾蓝 + 日出橙                        -->
    <!-- ============================================== -->

    <!-- Neutral base: Le Havre harbor morning fog -->
    <Color x:Key="BgBase">#F4F6F9</Color>
    <Color x:Key="BgSurface">#EBF0F5</Color>
    <Color x:Key="BgElevated">#FFFFFF</Color>
    <Color x:Key="BgHover">#E0E7EF</Color>
    <Color x:Key="BgActive">#D2DBE7</Color>
    <Color x:Key="BorderColor">#D0D8E4</Color>
    <Color x:Key="BorderLight">#AEB9C9</Color>

    <!-- Text hierarchy: cool harbor ink -->
    <Color x:Key="InkPrimary">#16202E</Color>
    <Color x:Key="InkSecondary">#455468</Color>
    <Color x:Key="InkTertiary">#5E6B7C</Color>

    <!-- Accent: rising sun through mist (darkened for AA button text) -->
    <Color x:Key="Accent">#C4550A</Color>
    <Color x:Key="AccentHover">#A84908</Color>
    <Color x:Key="AccentPressed">#8F3E06</Color>
    <Color x:Key="OnAccent">#FFFFFF</Color>

    <!-- Status semantics -->
    <Color x:Key="StatusBlue">#1D6FDC</Color>
    <Color x:Key="StatusGray">#5E6B7C</Color>
    <Color x:Key="StatusGreen">#15803D</Color>
    <Color x:Key="StatusWarning">#B45309</Color>
    <Color x:Key="StatusError">#DC2626</Color>
    <Color x:Key="BtnDanger">#D92D20</Color>
    <Color x:Key="BtnDangerHover">#C5281C</Color>
    <Color x:Key="BtnDangerPressed">#A91F15</Color>

    <Color x:Key="StatusWarningBg">#15EAB308</Color>
    <Color x:Key="StatusErrorBg">#10DC2626</Color>

    <Color x:Key="ConnBadgeBg">#0D15803D</Color>
    <Color x:Key="ConnBadgeBorder">#3315803D</Color>

    <Color x:Key="DiffMatchBg">#1A15803D</Color>
    <Color x:Key="DiffDiffBg">#15DC2626</Color>
    <Color x:Key="CompareDiffBg">#28F2762E</Color>

    <!-- Sun disc on pale water -->
    <Color x:Key="SearchHighlight">#50F2762E</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource BgBase}" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurface}" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevated}" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHover}" />
    <SolidColorBrush x:Key="BgActiveBrush" Color="{StaticResource BgActive}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}" />
    <SolidColorBrush x:Key="InkPrimaryBrush" Color="{StaticResource InkPrimary}" />
    <SolidColorBrush x:Key="InkSecondaryBrush" Color="{StaticResource InkSecondary}" />
    <SolidColorBrush x:Key="InkTertiaryBrush" Color="{StaticResource InkTertiary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressed}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccent}" />
    <SolidColorBrush x:Key="StatusBlueBrush" Color="{StaticResource StatusBlue}" />
    <SolidColorBrush x:Key="StatusGrayBrush" Color="{StaticResource StatusGray}" />
    <SolidColorBrush x:Key="StatusGreenBrush" Color="{StaticResource StatusGreen}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarning}" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusError}" />
    <SolidColorBrush x:Key="StatusWarningBgBrush" Color="{StaticResource StatusWarningBg}" />
    <SolidColorBrush x:Key="StatusErrorBgBrush" Color="{StaticResource StatusErrorBg}" />
    <SolidColorBrush x:Key="RedErrorBrush" Color="{StaticResource StatusError}" />
    <SolidColorBrush x:Key="BtnDangerBrush" Color="{StaticResource BtnDanger}" />
    <SolidColorBrush x:Key="BtnDangerHoverBrush" Color="{StaticResource BtnDangerHover}" />
    <SolidColorBrush x:Key="BtnDangerPressedBrush" Color="{StaticResource BtnDangerPressed}" />
    <SolidColorBrush x:Key="SearchHighlightBrush" Color="{StaticResource SearchHighlight}" />
    <SolidColorBrush x:Key="ConnBadgeBgBrush" Color="{StaticResource ConnBadgeBg}" />
    <SolidColorBrush x:Key="ConnBadgeBorderBrush" Color="{StaticResource ConnBadgeBorder}" />
    <SolidColorBrush x:Key="DiffMatchBgBrush" Color="{StaticResource DiffMatchBg}" />
    <SolidColorBrush x:Key="DiffDiffBgBrush" Color="{StaticResource DiffDiffBg}" />
    <SolidColorBrush x:Key="CompareDiffBgBrush" Color="{StaticResource CompareDiffBg}" />

    <SolidColorBrush x:Key="DividerBrush" Color="#D0D8E4" />

    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#06000000" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C5CEDA" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#AEB9C9" />
    <SolidColorBrush x:Key="ScrollThumbPressBrush" Color="#97A4B7" />

</ResourceDictionary>
