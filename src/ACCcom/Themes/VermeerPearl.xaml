<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================== -->
    <!-- 维米尔《戴珍珠耳环的少女》1665                    -->
    <!-- 深墨底 + 珍珠青 + 柠檬黄点缀，古典油画            -->
    <!-- ============================================== -->

    <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="3"
                      Opacity="0.38" Color="#05070C" Direction="270" />
    <DropShadowEffect x:Key="SubtleShadow" BlurRadius="8" ShadowDepth="1"
                      Opacity="0.24" Color="#05070C" Direction="270" />

    <!-- Neutral base: the dark ink of the background -->
    <Color x:Key="BgBase">#1E232E</Color>
    <Color x:Key="BgSurface">#262C39</Color>
    <Color x:Key="BgElevated">#303747</Color>
    <Color x:Key="BgHover">#3B4356</Color>
    <Color x:Key="BgActive">#484F65</Color>
    <Color x:Key="BorderColor">#2C3341</Color>
    <Color x:Key="BorderLight">#4A5468</Color>

    <!-- Text hierarchy: pearl ivory -->
    <Color x:Key="InkPrimary">#F1ECE0</Color>
    <Color x:Key="InkSecondary">#BAB6AC</Color>
    <Color x:Key="InkTertiary">#94928A</Color>

    <!-- Accent: the turban's pearl-teal glint -->
    <Color x:Key="Accent">#2FBFA5</Color>
    <Color x:Key="AccentHover">#45D2B8</Color>
    <Color x:Key="AccentPressed">#1FA78E</Color>
    <Color x:Key="OnAccent">#06231D</Color>

    <!-- Status semantics -->
    <Color x:Key="StatusBlue">#5EA8D8</Color>
    <Color x:Key="StatusGray">#94928A</Color>
    <Color x:Key="StatusGreen">#6FC287</Color>
    <!-- Lemon yellow of the draped cloth -->
    <Color x:Key="StatusWarning">#E3C95F</Color>
    <Color x:Key="StatusError">#EE8877</Color>
    <!-- Danger button: deep red keeps white button text AA on every state -->
    <Color x:Key="BtnDanger">#CE4227</Color>
    <Color x:Key="BtnDangerHover">#B93A20</Color>
    <Color x:Key="BtnDangerPressed">#9F321B</Color>

    <Color x:Key="StatusWarningBg">#18E3C95F</Color>
    <Color x:Key="StatusErrorBg">#18EE8877</Color>

    <Color x:Key="ConnBadgeBg">#0D6FC287</Color>
    <Color x:Key="ConnBadgeBorder">#336FC287</Color>

    <Color x:Key="DiffMatchBg">#336FC287</Color>
    <Color x:Key="DiffDiffBg">#33EE8877</Color>
    <Color x:Key="CompareDiffBg">#33E3C95F</Color>

    <!-- Pearl glint -->
    <Color x:Key="SearchHighlight">#402FBFA5</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource BgBase}" />
    <!-- Surface: glazed oil layers, soft light from the left -->
    <LinearGradientBrush x:Key="BgSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#292F3D" Offset="0" />
        <GradientStop Color="#232935" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BgElevatedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#333B4C" Offset="0" />
        <GradientStop Color="#2C3341" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHover}" />
    <SolidColorBrush x:Key="BgActiveBrush" Color="{StaticResource BgActive}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}" />
    <SolidColorBrush x:Key="InkPrimaryBrush" Color="{StaticResource InkPrimary}" />
    <SolidColorBrush x:Key="InkSecondaryBrush" Color="{StaticResource InkSecondary}" />
    <SolidColorBrush x:Key="InkTertiaryBrush" Color="{StaticResource InkTertiary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressed}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccent}" />
    <SolidColorBrush x:Key="StatusBlueBrush" Color="{StaticResource StatusBlue}" />
    <SolidColorBrush x:Key="StatusGrayBrush" Color="{StaticResource StatusGray}" />
    <SolidColorBrush x:Key="StatusGreenBrush" Color="{StaticResource StatusGreen}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarning}" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusError}" />
    <SolidColorBrush x:Key="StatusWarningBgBrush" Color="{StaticResource StatusWarningBg}" />
    <SolidColorBrush x:Key="StatusErrorBgBrush" Color="{StaticResource StatusErrorBg}" />
    <SolidColorBrush x:Key="RedErrorBrush" Color="{StaticResource StatusError}" />
    <SolidColorBrush x:Key="BtnDangerBrush" Color="{StaticResource BtnDanger}" />
    <SolidColorBrush x:Key="BtnDangerHoverBrush" Color="{StaticResource BtnDangerHover}" />
    <SolidColorBrush x:Key="BtnDangerPressedBrush" Color="{StaticResource BtnDangerPressed}" />
    <SolidColorBrush x:Key="SearchHighlightBrush" Color="{StaticResource SearchHighlight}" />
    <SolidColorBrush x:Key="ConnBadgeBgBrush" Color="{StaticResource ConnBadgeBg}" />
    <SolidColorBrush x:Key="ConnBadgeBorderBrush" Color="{StaticResource ConnBadgeBorder}" />
    <SolidColorBrush x:Key="DiffMatchBgBrush" Color="{StaticResource DiffMatchBg}" />
    <SolidColorBrush x:Key="DiffDiffBgBrush" Color="{StaticResource DiffDiffBg}" />
    <SolidColorBrush x:Key="CompareDiffBgBrush" Color="{StaticResource CompareDiffBg}" />

    <SolidColorBrush x:Key="DividerBrush" Color="#2C3341" />

    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4A5468" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#5A647E" />
    <SolidColorBrush x:Key="ScrollThumbPressBrush" Color="#6A748E" />

</ResourceDictionary>
