<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================== -->
    <!-- 维米尔《戴珍珠耳环的少女》1665                    -->
    <!-- 青金头巾 + 柠檬黄 + 深墨背景，古典油画             -->
    <!-- ============================================== -->

    <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="3"
                      Opacity="0.38" Color="#05070C" Direction="270" />
    <DropShadowEffect x:Key="SubtleShadow" BlurRadius="8" ShadowDepth="1"
                      Opacity="0.24" Color="#05070C" Direction="270" />

    <!-- Neutral base: the dark ink of the background -->
    <Color x:Key="BgBase">#20242E</Color>
    <Color x:Key="BgSurface">#272C38</Color>
    <Color x:Key="BgElevated">#303645</Color>
    <Color x:Key="BgHover">#3A4152</Color>
    <Color x:Key="BgActive">#454D61</Color>
    <Color x:Key="BorderColor">#2F3542</Color>
    <Color x:Key="BorderLight">#495165</Color>

    <!-- Text hierarchy: pearl ivory -->
    <Color x:Key="InkPrimary">#F0EBDD</Color>
    <Color x:Key="InkSecondary">#B7B5AE</Color>
    <Color x:Key="InkTertiary">#8B8B87</Color>

    <!-- Accent: ultramarine-teal turban -->
    <Color x:Key="Accent">#3E8E9E</Color>
    <Color x:Key="AccentHover">#55A6B5</Color>
    <Color x:Key="AccentPressed">#2F7684</Color>

    <!-- Status semantics -->
    <Color x:Key="StatusBlue">#6FA8B8</Color>
    <Color x:Key="StatusGray">#8B8B87</Color>
    <Color x:Key="StatusGreen">#8FAF7E</Color>
    <!-- Lemon yellow of the draped cloth -->
    <Color x:Key="StatusWarning">#E3C95F</Color>
    <Color x:Key="StatusError">#C96A5E</Color>

    <Color x:Key="StatusWarningBg">#18E3C95F</Color>
    <Color x:Key="StatusErrorBg">#18C96A5E</Color>

    <Color x:Key="ConnBadgeBg">#0D8FAF7E</Color>
    <Color x:Key="ConnBadgeBorder">#338FAF7E</Color>

    <Color x:Key="DiffMatchBg">#338FAF7E</Color>
    <Color x:Key="DiffDiffBg">#33C96A5E</Color>

    <!-- Pearl glint -->
    <Color x:Key="SearchHighlight">#38E8DFC8</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource BgBase}" />
    <!-- Surface: glazed oil layers, soft light from the left -->
    <LinearGradientBrush x:Key="BgSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2B303D" Offset="0" />
        <GradientStop Color="#252A35" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BgElevatedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#343B4B" Offset="0" />
        <GradientStop Color="#2D3341" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHover}" />
    <SolidColorBrush x:Key="BgActiveBrush" Color="{StaticResource BgActive}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}" />
    <SolidColorBrush x:Key="InkPrimaryBrush" Color="{StaticResource InkPrimary}" />
    <SolidColorBrush x:Key="InkSecondaryBrush" Color="{StaticResource InkSecondary}" />
    <SolidColorBrush x:Key="InkTertiaryBrush" Color="{StaticResource InkTertiary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressed}" />
    <SolidColorBrush x:Key="StatusBlueBrush" Color="{StaticResource StatusBlue}" />
    <SolidColorBrush x:Key="StatusGrayBrush" Color="{StaticResource StatusGray}" />
    <SolidColorBrush x:Key="StatusGreenBrush" Color="{StaticResource StatusGreen}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarning}" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusError}" />
    <SolidColorBrush x:Key="RedErrorBrush" Color="{StaticResource StatusError}" />
    <SolidColorBrush x:Key="SearchHighlightBrush" Color="{StaticResource SearchHighlight}" />
    <SolidColorBrush x:Key="ConnBadgeBgBrush" Color="{StaticResource ConnBadgeBg}" />
    <SolidColorBrush x:Key="ConnBadgeBorderBrush" Color="{StaticResource ConnBadgeBorder}" />

    <SolidColorBrush x:Key="DividerBrush" Color="#2F3542" />

    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#495165" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#59617A" />
    <SolidColorBrush x:Key="ScrollThumbPressBrush" Color="#69718A" />

    <!-- ============================================== -->
    <!-- Signature texture: 亚麻布纹 (Dutch linen weave)  -->
    <!-- Warp/weft basketweave + a pearl glint           -->
    <!-- ============================================== -->
    <DrawingBrush x:Key="CardTextureBrush" TileMode="Tile" Viewport="0,0,8,8"
                  ViewportUnits="Absolute" Opacity="0.05">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <!-- weft threads (horizontal) -->
                <GeometryDrawing Geometry="M0,1 H4 M4,5 H8">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#C9BFA0" Thickness="1.1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- warp threads (vertical) -->
                <GeometryDrawing Geometry="M5,0 V4 M1,4 V8">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#A89F86" Thickness="1.1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- rarer, larger-scale accent: a single pearl glint per 160px -->
    <DrawingBrush x:Key="CardPearlBrush" TileMode="Tile" Viewport="0,0,160,160"
                  ViewportUnits="Absolute" Opacity="0.07">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="80,80" RadiusX="5" RadiusY="5" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush GradientOrigin="0.35,0.35">
                            <GradientStop Color="#F5F2E8" Offset="0" />
                            <GradientStop Color="#77B4C4" Offset="0.65" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
