<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================== -->
    <!-- 克里姆特《吻》1908                               -->
    <!-- 拜占庭金箔 + 深绿黑，奢华装饰风                   -->
    <!-- ============================================== -->

    <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="3"
                      Opacity="0.45" Color="#000000" Direction="270" />
    <DropShadowEffect x:Key="SubtleShadow" BlurRadius="8" ShadowDepth="1"
                      Opacity="0.28" Color="#000000" Direction="270" />

    <!-- Neutral base: the dark meadow of gold leaf -->
    <Color x:Key="BgBase">#191E15</Color>
    <Color x:Key="BgSurface">#21271B</Color>
    <Color x:Key="BgElevated">#2A3222</Color>
    <Color x:Key="BgHover">#343D2B</Color>
    <Color x:Key="BgActive">#404A35</Color>
    <Color x:Key="BorderColor">#2C3423</Color>
    <Color x:Key="BorderLight">#4A5539</Color>

    <!-- Text hierarchy: champagne ivory -->
    <Color x:Key="InkPrimary">#F3ECD3</Color>
    <Color x:Key="InkSecondary">#C2BD9F</Color>
    <Color x:Key="InkTertiary">#98957C</Color>

    <!-- Accent: Byzantine gold leaf -->
    <Color x:Key="Accent">#D9B44A</Color>
    <Color x:Key="AccentHover">#E8C968</Color>
    <Color x:Key="AccentPressed">#BF9A32</Color>
    <Color x:Key="OnAccent">#1B1B1B</Color>

    <!-- Status semantics -->
    <Color x:Key="StatusBlue">#8FA67E</Color>
    <Color x:Key="StatusGray">#98957C</Color>
    <Color x:Key="StatusGreen">#A3B36B</Color>
    <Color x:Key="StatusWarning">#D9B44A</Color>
    <Color x:Key="StatusError">#CE6E5E</Color>

    <Color x:Key="StatusWarningBg">#18D9B44A</Color>
    <Color x:Key="StatusErrorBg">#18C4685A</Color>

    <Color x:Key="ConnBadgeBg">#0DA3B36B</Color>
    <Color x:Key="ConnBadgeBorder">#33A3B36B</Color>

    <Color x:Key="DiffMatchBg">#33A3B36B</Color>
    <Color x:Key="DiffDiffBg">#33C4685A</Color>

    <Color x:Key="SearchHighlight">#38E8C968</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource BgBase}" />
    <!-- Surface: gilded ground, faint sheen from above -->
    <LinearGradientBrush x:Key="BgSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#252C1E" Offset="0" />
        <GradientStop Color="#1F2519" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BgElevatedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2F3826" Offset="0" />
        <GradientStop Color="#28301F" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHover}" />
    <SolidColorBrush x:Key="BgActiveBrush" Color="{StaticResource BgActive}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}" />
    <SolidColorBrush x:Key="InkPrimaryBrush" Color="{StaticResource InkPrimary}" />
    <SolidColorBrush x:Key="InkSecondaryBrush" Color="{StaticResource InkSecondary}" />
    <SolidColorBrush x:Key="InkTertiaryBrush" Color="{StaticResource InkTertiary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressed}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccent}" />
    <SolidColorBrush x:Key="StatusBlueBrush" Color="{StaticResource StatusBlue}" />
    <SolidColorBrush x:Key="StatusGrayBrush" Color="{StaticResource StatusGray}" />
    <SolidColorBrush x:Key="StatusGreenBrush" Color="{StaticResource StatusGreen}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarning}" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusError}" />
    <SolidColorBrush x:Key="RedErrorBrush" Color="{StaticResource StatusError}" />
    <SolidColorBrush x:Key="SearchHighlightBrush" Color="{StaticResource SearchHighlight}" />
    <SolidColorBrush x:Key="ConnBadgeBgBrush" Color="{StaticResource ConnBadgeBg}" />
    <SolidColorBrush x:Key="ConnBadgeBorderBrush" Color="{StaticResource ConnBadgeBorder}" />

    <SolidColorBrush x:Key="DividerBrush" Color="#2C3423" />

    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4A5539" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#5A6549" />
    <SolidColorBrush x:Key="ScrollThumbPressBrush" Color="#6A7559" />

    <!-- ============================================== -->
    <!-- Signature texture: 金箔镶嵌纹 (Byzantine gold     -->
    <!-- mosaic) — gold-leaf patches, halo, bead rows    -->
    <!-- ============================================== -->
    <DrawingBrush x:Key="CardTextureBrush" TileMode="Tile" Viewport="0,0,56,56"
                  ViewportUnits="Absolute" Opacity="0.07">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <!-- gold-leaf rectangle patches, hand-set like tesserae -->
                <GeometryDrawing Geometry="M4,4 H14 V14 H4 Z">
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#C9A227" />
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M32,12 H40 V20 H32 Z">
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#8C6D1F" />
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M18,26 H24 V32 H18 Z">
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#E3C567" />
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <!-- the halo / sun disc of The Kiss -->
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="43,40" RadiusX="5.5" RadiusY="5.5" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#E8C968" />
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <!-- black chalk outlines Klimt sketched beneath the gold -->
                <GeometryDrawing Geometry="M4,4 H14 V14 H4 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#191E15" Thickness="1.2" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- rows of gold beads -->
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="9,40" RadiusX="2" RadiusY="2" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#D9B44A" />
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="17,44" RadiusX="2" RadiusY="2" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#D9B44A" />
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="25,40" RadiusX="2" RadiusY="2" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#B9953B" />
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
