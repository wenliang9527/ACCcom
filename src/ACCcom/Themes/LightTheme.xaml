<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================== -->
    <!-- Effects                                       -->
    <!-- ============================================== -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="2"
                      Opacity="0.06" Color="#1A1A2E" Direction="270" />
    <DropShadowEffect x:Key="SubtleShadow" BlurRadius="8" ShadowDepth="1"
                      Opacity="0.04" Color="#1A1A2E" Direction="270" />

    <!-- ============================================== -->
    <!-- Light Tech Minimal Palette                     -->
    <!-- ============================================== -->

    <!-- Neutral base (clean white) -->
    <Color x:Key="BgBase">#FFFFFF</Color>
    <Color x:Key="BgSurface">#F9FAFB</Color>
    <Color x:Key="BgElevated">#FFFFFF</Color>
    <Color x:Key="BgHover">#F3F4F6</Color>
    <Color x:Key="BgActive">#E5E7EB</Color>
    <Color x:Key="BorderColor">#E5E7EB</Color>
    <Color x:Key="BorderLight">#D1D5DB</Color>

    <!-- Text hierarchy (cool dark) -->
    <Color x:Key="InkPrimary">#1A1D24</Color>
    <Color x:Key="InkSecondary">#5A6070</Color>
    <Color x:Key="InkTertiary">#9CA3AF</Color>

    <!-- Accent: violet -->
    <Color x:Key="Accent">#8B5CF6</Color>
    <Color x:Key="AccentHover">#A78BFA</Color>
    <Color x:Key="AccentPressed">#7C3AED</Color>

    <!-- Status semantics -->
    <Color x:Key="StatusBlue">#8B5CF6</Color>
    <Color x:Key="StatusGray">#9CA3AF</Color>
    <Color x:Key="StatusGreen">#22C55E</Color>
    <Color x:Key="StatusWarning">#EAB308</Color>
    <Color x:Key="StatusError">#EF4444</Color>

    <!-- Status background tints -->
    <Color x:Key="StatusWarningBg">#15EAB308</Color>
    <Color x:Key="StatusErrorBg">#10DC2626</Color>

    <!-- Connection badge -->
    <Color x:Key="ConnBadgeBg">#0D22C55E</Color>
    <Color x:Key="ConnBadgeBorder">#3322C55E</Color>

    <!-- Diff badge backgrounds -->
    <Color x:Key="DiffMatchBg">#1A22C55E</Color>
    <Color x:Key="DiffDiffBg">#15EF4444</Color>

    <!-- Search highlight -->
    <Color x:Key="SearchHighlight">#50FFF3B0</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource BgBase}" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurface}" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevated}" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHover}" />
    <SolidColorBrush x:Key="BgActiveBrush" Color="{StaticResource BgActive}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}" />
    <SolidColorBrush x:Key="InkPrimaryBrush" Color="{StaticResource InkPrimary}" />
    <SolidColorBrush x:Key="InkSecondaryBrush" Color="{StaticResource InkSecondary}" />
    <SolidColorBrush x:Key="InkTertiaryBrush" Color="{StaticResource InkTertiary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressed}" />
    <SolidColorBrush x:Key="StatusBlueBrush" Color="{StaticResource StatusBlue}" />
    <SolidColorBrush x:Key="StatusGrayBrush" Color="{StaticResource StatusGray}" />
    <SolidColorBrush x:Key="StatusGreenBrush" Color="{StaticResource StatusGreen}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarning}" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusError}" />
    <SolidColorBrush x:Key="RedErrorBrush" Color="{StaticResource StatusError}" />
    <SolidColorBrush x:Key="SearchHighlightBrush" Color="{StaticResource SearchHighlight}" />
    <SolidColorBrush x:Key="ConnBadgeBgBrush" Color="{StaticResource ConnBadgeBg}" />
    <SolidColorBrush x:Key="ConnBadgeBorderBrush" Color="{StaticResource ConnBadgeBorder}" />

    <SolidColorBrush x:Key="DividerBrush" Color="#E5E7EB" />

    <!-- ScrollBar theme-local overrides -->
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#06000000" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#D1D5DB" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#B0B8C4" />
    <SolidColorBrush x:Key="ScrollThumbPressBrush" Color="#9CA3AF" />

    <!-- Signature texture: canvas weave (default) -->
    <DrawingBrush x:Key="CardTextureBrush" TileMode="Tile" Viewport="0,0,4,4"
                  ViewportUnits="Absolute" Opacity="0.06">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H4 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#000000" />
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,2 H2 V3 H0 Z">
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#FFFFFF" />
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
