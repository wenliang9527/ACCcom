<Window x:Class="ACCcom.ModbusConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ACCcom.Controls"
        xmlns:local="clr-namespace:ACCcom"
        Title="{Binding [ModbusConnection.Title], Source={x:Static local:LanguageManager.Instance}}" Height="250" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource BgBaseBrush}"
        Style="{StaticResource WindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar (Close only for dialogs) -->
        <controls:ChromeTitleBar Grid.Row="0" x:Name="TitleBar"
                 ShowMinMax="False" ShowClose="False"
                 Title="{Binding [ModbusConnection.Title], Source={x:Static local:LanguageManager.Instance}}">
            <controls:ChromeTitleBar.ExtraButtons>
                <Button Content="&#x2715;" Style="{StaticResource TitleBarCloseButton}" FontSize="{StaticResource FontSizeBody}" Width="46" Height="28" Click="TitleBarClose_Click" ToolTip="{Binding [TitleBar.Close], Source={x:Static local:LanguageManager.Instance}}" />
            </controls:ChromeTitleBar.ExtraButtons>
        </controls:ChromeTitleBar>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding [ModbusConnection.SelectTransport], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource SectionHeader}" Margin="0,0,0,12" />

        <Border Grid.Row="1" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
            <StackPanel>
                <RadioButton Content="{Binding [ModbusConnection.RTU], Source={x:Static local:LanguageManager.Instance}}" IsChecked="{Binding IsRtuMode}" Margin="0,0,0,8" FontSize="{StaticResource FontSizeBodyLarge}" Foreground="{DynamicResource InkPrimaryBrush}" />
                <RadioButton Content="{Binding [ModbusConnection.ASCII], Source={x:Static local:LanguageManager.Instance}}" IsChecked="{Binding IsAsciiMode}" Margin="0,0,0,8" FontSize="{StaticResource FontSizeBodyLarge}" Foreground="{DynamicResource InkPrimaryBrush}" />
                <RadioButton Content="{Binding [ModbusConnection.TCP], Source={x:Static local:LanguageManager.Instance}}" IsChecked="{Binding IsTcpMode}" FontSize="{StaticResource FontSizeBodyLarge}" Foreground="{DynamicResource InkPrimaryBrush}" />

                <StackPanel IsEnabled="{Binding IsTcpMode}" Margin="20,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [ModbusConnection.Host], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Host}" Style="{StaticResource NumericBox}" Height="24" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding [ModbusConnection.Port], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" />
                        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding Port}" Style="{StaticResource NumericBox}" Height="24" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Style="{StaticResource Label}" Margin="0,8,0,0" Foreground="{DynamicResource AccentBrush}" />

        <Button Grid.Row="4" Content="{Binding [ModbusConnection.Connect], Source={x:Static local:LanguageManager.Instance}}"
                Command="{Binding ConnectCommand}"
                Style="{StaticResource PrimaryButton}"
                Height="32" FontSize="{StaticResource FontSizeSubtitle}" />
        </Grid>
    </Grid>
</Window>
