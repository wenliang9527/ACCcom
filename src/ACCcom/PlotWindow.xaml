<Window x:Class="ACCcom.PlotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ACCcom"
        Title="{Binding [Plot.Title], Source={x:Static local:LanguageManager.Instance}}" Height="450" Width="700"
        MinHeight="300" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource BgBaseBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource BgSurfaceBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding [Plot.Title], Source={x:Static local:LanguageManager.Instance}}"
                           Foreground="{DynamicResource InkSecondaryBrush}"
                           FontSize="12" FontWeight="Medium"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="&#x2500;" Style="{StaticResource TitleBarButton}" FontSize="10" Width="46" Height="32" Click="TitleBarMin_Click" ToolTip="{Binding [TitleBar.Minimize], Source={x:Static local:LanguageManager.Instance}}" />
                    <Button Content="&#x25A1;" Style="{StaticResource TitleBarButton}" FontSize="9" Width="46" Height="32" Click="TitleBarMax_Click" ToolTip="{Binding [TitleBar.Maximize], Source={x:Static local:LanguageManager.Instance}}" />
                    <Button Content="&#x2715;" Style="{StaticResource TitleBarCloseButton}" FontSize="11" Width="46" Height="32" Click="TitleBarClose_Click" ToolTip="{Binding [TitleBar.Close], Source={x:Static local:LanguageManager.Instance}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header toolbar -->
        <Border Grid.Row="0" Padding="8,4" Background="{DynamicResource BgSurfaceBrush}" CornerRadius="6" Margin="0,0,0,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Plot.CurrentValue], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="LatestValueText" Text="--"
                              FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                              Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="PointCountText" Text="{Binding [Plot.ZeroPoints], Source={x:Static local:LanguageManager.Instance}}"
                              FontSize="11" Foreground="{DynamicResource InkTertiaryBrush}"
                              VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Plot.YRange], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock x:Name="YRangeText" Text="--"
                              FontFamily="Consolas" FontSize="11"
                              Foreground="{DynamicResource InkSecondaryBrush}" VerticalAlignment="Center" />
                    <Button Content="{Binding [Plot.Clear], Source={x:Static local:LanguageManager.Instance}}" Click="Clear_Click" Margin="12,0,0,0"
                            Style="{StaticResource OutlineButton}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Chart area -->
        <Border Grid.Row="1" Background="{DynamicResource BgSurfaceBrush}" CornerRadius="6"
                ClipToBounds="True">
            <Grid>
                <!-- Y-axis labels -->
                <Canvas x:Name="YAxisCanvas" Width="50" HorizontalAlignment="Left" />
                <!-- Main plot canvas -->
                <Canvas x:Name="PlotCanvas" Margin="50,4,4,4" />
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="2" Padding="8,3" Background="{DynamicResource BgSurfaceBrush}" CornerRadius="6" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="{Binding [Plot.Waiting], Source={x:Static local:LanguageManager.Instance}}"
                           FontSize="11" Foreground="{DynamicResource InkTertiaryBrush}" />
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</Window>
