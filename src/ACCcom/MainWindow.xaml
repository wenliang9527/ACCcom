<Window x:Class="ACCcom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ACCcom"
        xmlns:controls="clr-namespace:ACCcom.Controls"
        Title="{Binding [App.Title], Source={x:Static local:LanguageManager.Instance}}" Height="820" Width="1200"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStyle="None"
        Background="{DynamicResource BgBaseBrush}"
        Style="{StaticResource WindowStyle}">

    <Window.Resources>
        <!-- Conn badge pill -->
        <Style x:Key="ConnBadge" TargetType="Border">
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="480" />
            <ColumnDefinition x:Name="SidebarSplitterColumn" Width="Auto" />
            <ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="0" MaxWidth="420" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================ -->
        <!-- Row 0: Custom Title Bar                                       -->
        <!-- ============================================================ -->
        <!-- Shared chrome title bar (R8): brand dot + title, the always-
             visible connection badge centered via CenterContent, and the
             standard min/max/close buttons from ChromeTitleBar. -->
        <controls:ChromeTitleBar Grid.Row="0" Grid.ColumnSpan="3" x:Name="TitleBar"
                                 BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}"
                                 ShowAccentDot="True"
                                 Title="{Binding [App.Title], Source={x:Static local:LanguageManager.Instance}}">
            <controls:ChromeTitleBar.CenterContent>
                <!-- 真正居中：连接状态徽章（始终可见，未连接灰色，已连接绿色） -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="10" Padding="10,2" VerticalAlignment="Center"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ConnBadgeBgBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ConnBadgeBorderBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource InkTertiaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource StatusGreenBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="{StaticResource FontSizeBody}" FontFamily="{StaticResource FontFamilyMono}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding [Conn.BadgeDisconnected], Source={x:Static local:LanguageManager.Instance}}" />
                                    <Setter Property="Foreground" Value="{DynamicResource InkTertiaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource StatusGreenBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <TextBlock.ToolTip>
                                <ToolTip>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding [Conn.BadgeDisconnectedTip], Source={x:Static local:LanguageManager.Instance}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                        <Setter Property="Text" Value="{Binding SelectedPort}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
            </controls:ChromeTitleBar.CenterContent>
        </controls:ChromeTitleBar>

        <!-- ============================================================ -->
        <!-- Row 1: Toolbar — two stable lines                             -->
        <!--   L1 connection: mode / port / baud / parser | badge refresh  -->
        <!--   L2 tools: views / rx-tx toggles / prefs    | lang theme     -->
        <!--   Heights are Auto so wrapped tool buttons get a second row    -->
        <!--   instead of being clipped when the window narrows.            -->
        <!-- ============================================================ -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource BgSurfaceBrush}"
                Padding="10,0" Effect="{DynamicResource SubtleShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ── Line 1: connection (fields wrap; actions stay pinned right) ── -->
                <DockPanel Grid.Row="0" VerticalAlignment="Center" MinHeight="36" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,4">
                        <!-- Connection badge -->
                        <Border Style="{StaticResource ConnBadge}" Margin="0,0,8,0"
                                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}"
                                Background="{DynamicResource ConnBadgeBgBrush}" BorderThickness="1" BorderBrush="{DynamicResource ConnBadgeBorderBrush}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="5" Height="5" Fill="{DynamicResource StatusGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource StatusGreenBrush}" FontWeight="Medium"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding SelectedPort}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedConnectionType}" Value="TCP">
                                                    <Setter Property="Text" Value="{Binding NetworkHost, StringFormat='TCP:{0}'}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedConnectionType}" Value="UDP">
                                                    <Setter Property="Text" Value="{Binding NetworkHost, StringFormat='UDP:{0}'}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Button Content="{Binding [Button.Refresh], Source={x:Static local:LanguageManager.Instance}}" Command="{Binding RefreshPortsCommand}"
                                Style="{StaticResource OutlineButton}" Margin="0,0,6,0" />
                        <Button Content="{Binding IsOpen, Converter={StaticResource BoolToOpenText}}"
                                Margin="0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource OpenCloseButton}">
                                    <Setter Property="Command" Value="{Binding OpenCloseCommand}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedConnectionType}" Value="TCP">
                                            <Setter Property="Command" Value="{Binding ConnectNetworkCommand}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedConnectionType}" Value="UDP">
                                            <Setter Property="Command" Value="{Binding ConnectNetworkCommand}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <controls:ConnectionPanel DataContext="{Binding}" Margin="0,4,8,0" />
                </DockPanel>

                <!-- ── Line 2: tools (wrap as groups) | lang / theme pinned right ── -->
                <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}">
                    <DockPanel VerticalAlignment="Center" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,4">
                            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                      Width="76" Margin="0,0,4,0" />
                            <Button Command="{Binding OpenThemeGalleryCommand}" Margin="0,0,2,0" Padding="8,0"
                                    ToolTip="{Binding [Theme.OpenGallery], Source={x:Static local:LanguageManager.Instance}}"
                                    Style="{StaticResource OutlineButton}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding SelectedThemeAccent}" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{Binding SelectedThemeName}" VerticalAlignment="Center" />
                                    <TextBlock Text=" &#x25BE;" VerticalAlignment="Center" Opacity="0.6" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <controls:ToolBarPanel x:Name="ToolBarPanelControl" DataContext="{Binding}" Margin="0,4,8,4" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- Row 2: Advanced params (collapsible, gear toggle)              -->
        <!-- ============================================================ -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{DynamicResource BgSurfaceBrush}"
                Padding="10,3,10,5"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}"
                Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVisibility}}">
            <WrapPanel Orientation="Horizontal">
                <!-- flow control -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,2">
                    <CheckBox Content="{Binding [Check.DTR], Source={x:Static local:LanguageManager.Instance}}" IsChecked="{Binding DtrEnable}" Margin="0,0,6,0" />
                    <CheckBox Content="{Binding [Check.RTS], Source={x:Static local:LanguageManager.Instance}}" IsChecked="{Binding RtsEnable}" />
                </StackPanel>

                <Rectangle Style="{StaticResource ToolSeparator}" Margin="0,0,8,0" />

                <!-- reconnect policy -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                    <CheckBox Content="{Binding [Label.AutoReconnect], Source={x:Static local:LanguageManager.Instance}}" IsChecked="{Binding AutoReconnect}" Margin="0,0,8,0"
                              ToolTip="{Binding [Label.Unlimited], Source={x:Static local:LanguageManager.Instance}}" />
                    <TextBlock Text="{Binding [Label.Interval], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,4,0" />
                    <TextBox Text="{Binding ReconnectIntervalMs, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource NumericBox}" Width="55" Margin="0,0,2,0" />
                    <TextBlock Text="ms" Style="{StaticResource Label}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding [Label.MaxAttempts], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,4,0" />
                    <TextBox Text="{Binding MaxReconnectAttempts, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource NumericBox}" Width="44" Margin="0,0,4,0"
                             ToolTip="{Binding [Label.Unlimited], Source={x:Static local:LanguageManager.Instance}}" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ============================================================ -->
        <!-- Row 3: RX / TX Panels with top accent strips                   -->
        <!-- ============================================================ -->
        <controls:DataPanel x:Name="DataPanelControl" Grid.Row="3" DataContext="{Binding}" />

        <!-- ===== Quick send sidebar (rows 3-5, right) ===== -->
        <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Grid.Row="3" Grid.RowSpan="3"
                      Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                      MinWidth="0"
                      Visibility="{Binding DataContext.ShowQuickSendSidebar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Border x:Name="Grip" Background="{DynamicResource DividerBrush}" CornerRadius="2"
                                Width="3" HorizontalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>
        <controls:QuickSendSidebar x:Name="QuickSendSidebarHost" Grid.Column="2" Grid.Row="3" Grid.RowSpan="3"
                                   DataContext="{Binding Shortcuts}"
                                   Visibility="{Binding DataContext.ShowQuickSendSidebar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

        <!-- Collapsed rail: only when the sidebar is hidden. Anchored left so a
             stale/overlapping hit-target can never sit in the middle of the panel. -->
        <Border x:Name="QuickSendRail" Grid.Column="2" Grid.Row="3" Grid.RowSpan="3"
                Width="28" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,1"
                Cursor="Hand" MouseLeftButtonUp="QuickSendRail_Click"
                ToolTip="{Binding [QuickSend.RailTip], Source={x:Static local:LanguageManager.Instance}}"
                Visibility="{Binding DataContext.ShowQuickSendSidebar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityInverted}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
                    <Style.Triggers>
                        <!-- Hover feedback: the rail was a silent click target before. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE700;" FontFamily="{StaticResource FontFamilyIcons}" FontSize="{StaticResource FontSizeTitle}"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="&#x25B8;" FontSize="{StaticResource FontSizeMicro}" Foreground="{DynamicResource InkTertiaryBrush}"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- ============================================================ -->
        <!-- Row 4: Send Bar                                                -->
        <!-- ============================================================ -->
        <controls:PaintedCard Grid.Row="4" Background="{DynamicResource BgSurfaceBrush}"
                CornerRadius="8" Effect="{DynamicResource SubtleShadow}"
                Padding="12,8" Margin="8,6,8,0">
            <!-- Two rows that each reflow: (1) mode/loop/source/stop/send wrap,
                 (2) send input. Groups are atomic so labels never detach. -->
            <StackPanel Orientation="Vertical">
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <!-- HEX + loop timing as one chip -->
                    <Border CornerRadius="6" Padding="8,4" Margin="0,0,6,6"
                            Background="{DynamicResource BgElevatedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Content="HEX" IsChecked="{Binding IsHexSend}" Margin="0,0,6,0"
                                      ToolTip="{Binding [Tip.SendHexBytes], Source={x:Static local:LanguageManager.Instance}}" />
                            <Rectangle Width="1" Height="14" Margin="2,0,6,0" VerticalAlignment="Center"
                                       Fill="{DynamicResource DividerBrush}" />
                            <CheckBox Content="{Binding [Check.Loop], Source={x:Static local:LanguageManager.Instance}}" IsChecked="{Binding IsLoopSend}" Margin="0,0,6,0"
                                      ToolTip="{Binding [Tip.LoopSendEnabled], Source={x:Static local:LanguageManager.Instance}}" />
                            <TextBox Text="{Binding LoopInterval, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource NumericBox}" Width="55"
                                     IsEnabled="{Binding IsLoopSend}"
                                     ToolTip="{Binding [Tip.LoopInterval], Source={x:Static local:LanguageManager.Instance}}" />
                            <TextBlock Text="ms" Style="{StaticResource Label}" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <!-- Loop source as its own chip (can wrap under HEX/loop) -->
                    <Border CornerRadius="6" Padding="6,4" Margin="0,0,6,6"
                            Background="{DynamicResource BgElevatedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding Shortcuts.LoopSources}"
                                  SelectedItem="{Binding Shortcuts.SelectedLoopSource, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  MinWidth="100" MaxWidth="150" Width="Auto" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center"
                                  ToolTip="{Binding [Loop.SourceTip], Source={x:Static local:LanguageManager.Instance}}" />
                    </Border>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                        <Button Content="{Binding [Button.Stop], Source={x:Static local:LanguageManager.Instance}}" Command="{Binding StopLoopCommand}"
                                Style="{StaticResource OutlineButton}" Width="44" Height="30"
                                Margin="0,0,5,0" IsEnabled="{Binding IsLooping}" />
                        <Button Content="{Binding [Button.Send], Source={x:Static local:LanguageManager.Instance}}" Command="{Binding SendCommand}"
                                Style="{StaticResource PrimaryButton}" MinWidth="70" Height="30" />
                    </StackPanel>
                </WrapPanel>

                <Grid>
                    <TextBox x:Name="SendTextBox"
                             Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}"
                             Height="30" AcceptsReturn="False" TextWrapping="NoWrap"
                             FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeSubtitle}"
                             Padding="10,0,30,0" VerticalContentAlignment="Center"
                             VerticalScrollBarVisibility="Disabled">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSendInputValid}" Value="False">
                                        <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBrush}" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                        <Setter Property="ToolTip"
                                                Value="{Binding HexValidationError}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Button x:Name="HistoryDropDownBtn" Content="&#x25BE;" Width="24" Height="30"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,2,0" Padding="0" FontSize="{StaticResource FontSizeCaption}" Cursor="Hand"
                            Style="{StaticResource HeaderButton}"
                            ToolTip="{Binding [Tip.SendHistory], Source={x:Static local:LanguageManager.Instance}}"
                            Click="HistoryDropDownBtn_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="HistoryContextMenu"
                                         ItemsSource="{Binding SendHistory}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding}" />
                                        <Setter Property="ToolTip" Value="{Binding}" />
                                        <EventSetter Event="Click" Handler="HistoryItem_Click" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                                <Separator />
                                <MenuItem Header="{Binding [Menu.ClearSendHistory], Source={x:Static local:LanguageManager.Instance}}"
                                          Command="{Binding ClearSendHistoryCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>
            </StackPanel>
        </controls:PaintedCard>

        <!-- ============================================================ -->
        <!-- Row 5: Multi-port Panel                                        -->
        <!-- ============================================================ -->
        <controls:PaintedCard Grid.Row="5" Background="{DynamicResource BgSurfaceBrush}"
                CornerRadius="8" Effect="{DynamicResource SubtleShadow}" Margin="8,6,8,4" Padding="10,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Label.AuxPorts], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ConnectedPorts.Count}" FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource InkTertiaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBox Text="{Binding NewPortTag, UpdateSourceTrigger=PropertyChanged}"
                             Width="56" FontSize="{StaticResource FontSizeBody}" Padding="4,2" Margin="0,0,4,0"
                             ToolTip="{Binding [Tip.NewPortTag], Source={x:Static local:LanguageManager.Instance}}" />
                    <TextBox Text="{Binding NewPortName, UpdateSourceTrigger=PropertyChanged}"
                             Width="76" FontSize="{StaticResource FontSizeBody}" Padding="4,2" Margin="0,0,4,0"
                             ToolTip="{Binding [Tip.NewPortName], Source={x:Static local:LanguageManager.Instance}}" />
                    <Button Content="&#xE710;" FontFamily="{StaticResource FontFamilyIcons}" Command="{Binding OpenMultiPortCommand}"
                            Style="{StaticResource OutlineButton}" FontSize="{StaticResource FontSizeBodyLarge}" Padding="4,0" Width="22" Height="24"
                            ToolTip="{Binding [Tip.NewPortAdd], Source={x:Static local:LanguageManager.Instance}}" />
                    <Button Content="x" Command="{Binding CloseAllPortsCommand}"
                            Style="{StaticResource HeaderButton}" FontSize="{StaticResource FontSizeSubtitle}" Padding="4,0" Margin="4,0,0,0" Height="24"
                            Foreground="{DynamicResource InkTertiaryBrush}"
                            ToolTip="{Binding [Status.AllAuxPortsClosed], Source={x:Static local:LanguageManager.Instance}}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ConnectedPorts}" Margin="0,0,10,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="10" Padding="9,2" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource StatusGreenBrush}"
                                             VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center">
                                        <Run Text="{Binding Tag, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text=" -> " Foreground="{DynamicResource InkTertiaryBrush}" />
                                        <Run Text="{Binding PortName, Mode=OneWay}" />
                                        <Run Text=" @ " Foreground="{DynamicResource InkTertiaryBrush}" />
                                        <Run Text="{Binding BaudRate, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="x" Cursor="Hand" Margin="6,0,0,0"
                                               Foreground="{DynamicResource InkTertiaryBrush}" FontSize="{StaticResource FontSizeSubtitle}"
                                               VerticalAlignment="Center">
                                        <TextBlock.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.CloseMultiPortCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" />
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </controls:PaintedCard>

        <!-- ============================================================ -->
        <!-- Row 6: Status Bar                                              -->
        <!-- ============================================================ -->
        <controls:StatusBarPanel Grid.Row="6" Grid.ColumnSpan="3" DataContext="{Binding}" />
    </Grid>
</Window>
