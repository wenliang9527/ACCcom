<Window x:Class="ACCcom.McpTrafficWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ACCcom.Controls"
        xmlns:local="clr-namespace:ACCcom"
        Title="{Binding [McpTraffic.Title], Source={x:Static local:LanguageManager.Instance}}" Height="540" Width="680"
        MinHeight="340" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Style="{StaticResource WindowStyle}"
        Background="{DynamicResource BgBaseBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Compact secondary button for the toolbar (24px vs OutlineButton's 28px). -->
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Toggle chrome matching ToolbarButton; checked state uses the accent. -->
        <Style x:Key="ToolbarToggle" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource InkPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgActiveBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pause toggle: same chrome, but the checked state reads as a warning
             (amber) instead of the accent so "stream frozen" is obvious. -->
        <Style x:Key="PauseToolbarToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolbarToggle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource InkPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StatusWarningBgBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StatusWarningBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tiny copy button for the detail rows. -->
        <Style x:Key="DetailCopyButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <controls:ChromeTitleBar Grid.Row="0" x:Name="TitleBar"
                                 Title="{Binding [McpTraffic.Title], Source={x:Static local:LanguageManager.Instance}}">
            <controls:ChromeTitleBar.ExtraButtons>
                <Button Content="&#xE74C;" Style="{StaticResource TitleBarButton}" FontSize="11" Width="46" Height="32" Click="Clear_Click" ToolTip="{Binding [McpTraffic.Clear], Source={x:Static local:LanguageManager.Instance}}" />
            </controls:ChromeTitleBar.ExtraButtons>
        </controls:ChromeTitleBar>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="8,4" Background="{DynamicResource BgSurfaceBrush}" CornerRadius="4" Margin="0,0,0,4">
                <TextBlock x:Name="HintText" FontSize="11" Foreground="{DynamicResource InkSecondaryBrush}"
                           Text="{Binding [McpTraffic.Hint], Source={x:Static local:LanguageManager.Instance}}" TextWrapping="Wrap" />
            </Border>

            <!-- Toolbar: HEX toggle, direction/tag filters, search, transport controls -->
            <Border Grid.Row="1" Padding="6,3" Background="{DynamicResource BgSurfaceBrush}" CornerRadius="4" Margin="0,0,0,4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="HexToggle" IsChecked="False" Click="HexToggle_Click"
                                      Content="HEX" Style="{StaticResource ToolbarToggle}"
                                      Margin="0,0,0,0"
                                      ToolTip="{Binding [McpTraffic.HexToggleTip], Source={x:Static local:LanguageManager.Instance}}" />
                        <Rectangle Style="{StaticResource ToolSeparator}" />
                        <RadioButton x:Name="FilterAll" GroupName="DirFilter" IsChecked="True" Checked="DirectionFilter_Changed"
                                     Content="{Binding [McpTraffic.FilterAll], Source={x:Static local:LanguageManager.Instance}}"
                                     FontSize="11" Foreground="{DynamicResource InkPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,8,0" />
                        <RadioButton x:Name="FilterRx" GroupName="DirFilter" Checked="DirectionFilter_Changed"
                                     Content="{Binding [McpTraffic.FilterRx], Source={x:Static local:LanguageManager.Instance}}"
                                     FontSize="11" Foreground="{DynamicResource InkPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <RadioButton x:Name="FilterTx" GroupName="DirFilter" Checked="DirectionFilter_Changed"
                                     Content="{Binding [McpTraffic.FilterTx], Source={x:Static local:LanguageManager.Instance}}"
                                     FontSize="11" Foreground="{DynamicResource InkPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Rectangle Style="{StaticResource ToolSeparator}" />
                        <ComboBox x:Name="TagFilterBox" MinWidth="90" Height="24" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                                  ToolTip="{Binding [McpTraffic.TagFilterTip], Source={x:Static local:LanguageManager.Instance}}"
                                  SelectionChanged="TagFilter_Changed" />
                        <ComboBox x:Name="ToolFilterBox" MinWidth="86" Height="24" FontSize="11" VerticalAlignment="Center"
                                  ToolTip="{Binding [McpTraffic.ToolFilterTip], Source={x:Static local:LanguageManager.Instance}}"
                                  SelectionChanged="ToolFilter_Changed" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="PauseToggle" IsChecked="False" Click="PauseToggle_Click"
                                      Content="{Binding [McpTraffic.Pause], Source={x:Static local:LanguageManager.Instance}}"
                                      Style="{StaticResource PauseToolbarToggle}"
                                      Margin="0,0,4,0"
                                      ToolTip="{Binding [McpTraffic.PauseTip], Source={x:Static local:LanguageManager.Instance}}" />
                        <Button x:Name="CopyButton" Click="Copy_Click"
                                Content="{Binding [McpTraffic.Copy], Source={x:Static local:LanguageManager.Instance}}"
                                Style="{StaticResource ToolbarButton}" Margin="0,0,4,0"
                                ToolTip="{Binding [McpTraffic.CopyTip], Source={x:Static local:LanguageManager.Instance}}" />
                        <Button x:Name="ExportButton" Click="Export_Click"
                                Content="{Binding [McpTraffic.Export], Source={x:Static local:LanguageManager.Instance}}"
                                Style="{StaticResource ToolbarButton}" Margin="0,0,4,0"
                                ToolTip="{Binding [McpTraffic.ExportTip], Source={x:Static local:LanguageManager.Instance}}" />
                        <Rectangle Style="{StaticResource ToolSeparator}" />
                        <CheckBox x:Name="FollowTail" IsChecked="True" Checked="FollowTail_Changed" Unchecked="FollowTail_Changed"
                                  Content="{Binding [McpTraffic.FollowTail], Source={x:Static local:LanguageManager.Instance}}"
                                  FontSize="11" Foreground="{DynamicResource InkPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- Search box fills the space between the filters and the
                         right-side controls; the placeholder overlays the empty
                         box and Esc clears the filter. -->
                    <Grid Margin="8,0,8,0" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" FontSize="11" Padding="6,2" VerticalContentAlignment="Center"
                                 Background="{DynamicResource BgElevatedBrush}" Foreground="{DynamicResource InkPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                 ToolTip="{Binding [McpTraffic.SearchHint], Source={x:Static local:LanguageManager.Instance}}"
                                 TextChanged="SearchText_Changed" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                        <TextBlock x:Name="SearchPlaceholder" IsHitTestVisible="False" Margin="7,0,0,0" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{DynamicResource InkTertiaryBrush}"
                                   Text="{Binding [McpTraffic.SearchHint], Source={x:Static local:LanguageManager.Instance}}" />
                    </Grid>
                </DockPanel>
            </Border>

            <ListView x:Name="TrafficList" Grid.Row="2"
                      Background="{DynamicResource BgSurfaceBrush}"
                      BorderThickness="0"
                      FontFamily="Consolas" FontSize="12"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectionChanged="TrafficList_SelectionChanged"
                      MouseDoubleClick="TrafficList_MouseDoubleClick"
                      PreviewMouseRightButtonDown="TrafficList_PreviewMouseRightButtonDown">
                <ListView.ContextMenu>
                    <ContextMenu Opened="TrafficContext_Opened">
                        <MenuItem Header="{Binding [McpTraffic.CopyText], Source={x:Static local:LanguageManager.Instance}}"
                                  Click="CtxCopyText_Click" />
                        <MenuItem Header="{Binding [Button.CopyHex], Source={x:Static local:LanguageManager.Instance}}"
                                  Click="CtxCopyHex_Click" />
                        <MenuItem Header="{Binding [McpTraffic.CopyRow], Source={x:Static local:LanguageManager.Instance}}"
                                  Click="CtxCopyRow_Click" />
                        <Separator />
                        <MenuItem x:Name="CtxFilterTag" Click="CtxFilterTag_Click" />
                        <Separator />
                        <MenuItem Header="{Binding [McpTraffic.Clear], Source={x:Static local:LanguageManager.Instance}}"
                                  Click="Clear_Click" />
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn x:Name="IdColumn" Header="{Binding [McpTraffic.Id], Source={x:Static local:LanguageManager.Instance}}" Width="50" DisplayMemberBinding="{Binding IdText}" />
                        <GridViewColumn x:Name="TimeColumn" Header="{Binding [McpTraffic.Time], Source={x:Static local:LanguageManager.Instance}}" Width="90" DisplayMemberBinding="{Binding Time}" />
                        <GridViewColumn x:Name="DirectionColumn" Header="{Binding [McpTraffic.Direction], Source={x:Static local:LanguageManager.Instance}}" Width="48">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- Direction pill: neutral surface + status border/text so the
                                         RX/TX split stays scannable without a full-colour row. -->
                                    <Border CornerRadius="3" Padding="6,1" BorderThickness="1"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{DynamicResource BgActiveBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <!-- Neutral default = SYS (open/close) rows; RX/TX get status colours. -->
                                                <Setter Property="BorderBrush" Value="{DynamicResource InkTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Direction}" Value="RX">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource StatusGreenBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Direction}" Value="TX">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource StatusWarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Direction}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource InkTertiaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Direction}" Value="RX">
                                                            <Setter Property="Foreground" Value="{DynamicResource StatusGreenBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Direction}" Value="TX">
                                                            <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="ToolColumn" Header="{Binding [McpTraffic.Tool], Source={x:Static local:LanguageManager.Instance}}" Width="110" DisplayMemberBinding="{Binding Tool}" />
                        <GridViewColumn x:Name="TagColumn" Header="{Binding [McpTraffic.Tag], Source={x:Static local:LanguageManager.Instance}}" Width="70" DisplayMemberBinding="{Binding Tag}" />
                        <GridViewColumn x:Name="LengthColumn" Header="{Binding [McpTraffic.Length], Source={x:Static local:LanguageManager.Instance}}" Width="44" DisplayMemberBinding="{Binding LenText}" />
                        <GridViewColumn x:Name="PayloadColumn" Header="{Binding [McpTraffic.Payload], Source={x:Static local:LanguageManager.Instance}}" Width="370">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Payload}">
                                    <TextBlock.Style>
                                        <!-- Same RX/TX colouring as the Direction
                                             column, so a scan of the payload text
                                             keeps the send/receive split obvious. -->
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource InkPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Direction}" Value="RX">
                                                    <Setter Property="Foreground" Value="{DynamicResource StatusGreenBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Direction}" Value="TX">
                                                    <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock Grid.Row="2" Visibility="Collapsed">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyListText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=TrafficList}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Selected-row detail: meta line + full text + hex, read-only,
                 selectable for copy, with per-field copy buttons. -->
            <Border Grid.Row="3" Padding="8,5" Background="{DynamicResource BgSurfaceBrush}" CornerRadius="4" Margin="0,4,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="DetailMetaText" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                               FontSize="10" Foreground="{DynamicResource InkSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,3" />

                    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="11" Foreground="{DynamicResource InkSecondaryBrush}"
                               VerticalAlignment="Center"
                               Text="{Binding [McpTraffic.DetailText], Source={x:Static local:LanguageManager.Instance}}" />
                    <TextBox x:Name="DetailTextBox" Grid.Row="1" Grid.Column="1" FontSize="11" FontFamily="Consolas"
                             IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource InkPrimaryBrush}" TextWrapping="Wrap" MaxHeight="120"
                             VerticalScrollBarVisibility="Auto" Margin="0,0,6,0" />
                    <Button Grid.Row="1" Grid.Column="2" Content="{Binding [McpTraffic.CopyText], Source={x:Static local:LanguageManager.Instance}}"
                            Style="{StaticResource DetailCopyButton}" Click="CopyDetailText_Click"
                            ToolTip="{Binding [McpTraffic.CopyText], Source={x:Static local:LanguageManager.Instance}}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" FontSize="11" Foreground="{DynamicResource InkSecondaryBrush}"
                               VerticalAlignment="Center"
                               Text="{Binding [McpTraffic.DetailHex], Source={x:Static local:LanguageManager.Instance}}" Margin="0,3,0,0" />
                    <TextBox x:Name="DetailHexBox" Grid.Row="2" Grid.Column="1" FontSize="11" FontFamily="Consolas"
                             IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource InkSecondaryBrush}" TextWrapping="Wrap" MaxHeight="120"
                             VerticalScrollBarVisibility="Auto" Margin="0,3,6,0" />
                    <Button Grid.Row="2" Grid.Column="2" Content="{Binding [Button.CopyHex], Source={x:Static local:LanguageManager.Instance}}"
                            Style="{StaticResource DetailCopyButton}" Click="CopyDetailHex_Click" Margin="0,3,0,0"
                            ToolTip="{Binding [Button.CopyHex], Source={x:Static local:LanguageManager.Instance}}" />

                    <!-- Shown while nothing is selected; overlay doesn't block
                         clicks so the empty textboxes stay selectable. -->
                    <TextBlock x:Name="DetailHint" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3"
                               FontSize="11" Foreground="{DynamicResource InkTertiaryBrush}"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Text="{Binding [McpTraffic.DetailHint], Source={x:Static local:LanguageManager.Instance}}" />
                </Grid>
            </Border>

            <!-- Status bar: row count + RX/TX tally + file size + last update + paused state -->
            <Border Grid.Row="4" Padding="6,2" Background="Transparent" Margin="0,2,0,0">
                <DockPanel>
                    <TextBlock x:Name="RowCountText" DockPanel.Dock="Left" FontSize="11"
                               Foreground="{DynamicResource InkSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="StatusText" FontSize="11"
                               Foreground="{DynamicResource InkTertiaryBrush}" VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
