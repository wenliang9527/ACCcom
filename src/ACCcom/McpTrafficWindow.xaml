<Window x:Class="ACCcom.McpTrafficWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ACCcom"
        Title="{Binding [McpTraffic.Title], Source={x:Static local:LanguageManager.Instance}}" Height="420" Width="640"
        MinHeight="260" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource BgBaseBrush}">

    <Window.Resources>
        <!-- Default ListView row chrome uses system black text + light selection
             highlight, which is illegible on the dark themes; re-skin rows with
             the active theme's brushes. Column headers come from the app-level
             implicit GridViewColumnHeader style. -->
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource InkPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="0,2">
                            <!-- Bare ContentPresenter would ToString() the row POCO under a
                                 GridView; GridViewRowPresenter renders the column cells and
                                 inherits this item's Foreground. -->
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource BgSurfaceBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding [McpTraffic.Title], Source={x:Static local:LanguageManager.Instance}}"
                           Foreground="{DynamicResource InkSecondaryBrush}"
                           FontSize="12" FontWeight="Medium"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="&#xE74C;" Style="{StaticResource TitleBarButton}" FontSize="11" Width="46" Height="32" Click="Clear_Click" ToolTip="{Binding [McpTraffic.Clear], Source={x:Static local:LanguageManager.Instance}}" />
                    <Button Content="&#x2715;" Style="{StaticResource TitleBarCloseButton}" FontSize="11" Width="46" Height="32" Click="TitleBarClose_Click" ToolTip="{Binding [TitleBar.Close], Source={x:Static local:LanguageManager.Instance}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="6,2" Background="{DynamicResource BgSurfaceBrush}" CornerRadius="4" Margin="0,0,0,4">
                <TextBlock x:Name="HintText" FontSize="11" Foreground="{DynamicResource InkTertiaryBrush}"
                           Text="{Binding [McpTraffic.Hint], Source={x:Static local:LanguageManager.Instance}}" TextWrapping="Wrap" />
            </Border>

            <!-- Toolbar: HEX display toggle, direction filter, auto-scroll + row count -->
            <Border Grid.Row="1" Padding="4,2" Background="{DynamicResource BgSurfaceBrush}" CornerRadius="4" Margin="0,0,0,4">
                <DockPanel>
                    <ToggleButton x:Name="HexToggle" DockPanel.Dock="Left" IsChecked="False" Click="HexToggle_Click"
                                  Content="HEX" FontSize="11" Foreground="{DynamicResource InkPrimaryBrush}"
                                  Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                  Margin="0,0,4,0" Padding="10,2" MinWidth="46"
                                  ToolTip="{Binding [McpTraffic.HexToggleTip], Source={x:Static local:LanguageManager.Instance}}" />
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <RadioButton x:Name="FilterAll" GroupName="DirFilter" IsChecked="True" Checked="DirectionFilter_Changed"
                                     Content="{Binding [McpTraffic.FilterAll], Source={x:Static local:LanguageManager.Instance}}"
                                     FontSize="11" Foreground="{DynamicResource InkPrimaryBrush}" VerticalAlignment="Center" Margin="6,0,8,0" />
                        <RadioButton x:Name="FilterRx" GroupName="DirFilter" Checked="DirectionFilter_Changed"
                                     Content="{Binding [McpTraffic.FilterRx], Source={x:Static local:LanguageManager.Instance}}"
                                     FontSize="11" Foreground="{DynamicResource InkPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <RadioButton x:Name="FilterTx" GroupName="DirFilter" Checked="DirectionFilter_Changed"
                                     Content="{Binding [McpTraffic.FilterTx], Source={x:Static local:LanguageManager.Instance}}"
                                     FontSize="11" Foreground="{DynamicResource InkPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    </StackPanel>
                    <CheckBox x:Name="FollowTail" DockPanel.Dock="Right" IsChecked="True" Checked="FollowTail_Changed" Unchecked="FollowTail_Changed"
                              Content="{Binding [McpTraffic.FollowTail], Source={x:Static local:LanguageManager.Instance}}"
                              FontSize="11" Foreground="{DynamicResource InkPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="RowCountText" DockPanel.Dock="Right" FontSize="11"
                               Foreground="{DynamicResource InkTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <!-- Search box fills the space between the filters and the
                         right-side controls; the placeholder overlays the empty
                         box and Esc clears the filter. -->
                    <Grid Margin="8,0,8,0" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" FontSize="11" Padding="6,2" VerticalContentAlignment="Center"
                                 Background="{DynamicResource BgElevatedBrush}" Foreground="{DynamicResource InkPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                 ToolTip="{Binding [McpTraffic.SearchHint], Source={x:Static local:LanguageManager.Instance}}"
                                 TextChanged="SearchText_Changed" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                        <TextBlock x:Name="SearchPlaceholder" IsHitTestVisible="False" Margin="7,0,0,0" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{DynamicResource InkTertiaryBrush}"
                                   Text="{Binding [McpTraffic.SearchHint], Source={x:Static local:LanguageManager.Instance}}" />
                    </Grid>
                </DockPanel>
            </Border>

            <ListView x:Name="TrafficList" Grid.Row="2"
                      Background="{DynamicResource BgSurfaceBrush}"
                      BorderThickness="0"
                      FontFamily="Consolas" FontSize="12"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{Binding [McpTraffic.Time], Source={x:Static local:LanguageManager.Instance}}" Width="90" DisplayMemberBinding="{Binding Time}" />
                        <GridViewColumn Header="{Binding [McpTraffic.Direction], Source={x:Static local:LanguageManager.Instance}}" Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Direction}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Direction}" Value="RX">
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusGreenBrush}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Direction}" Value="TX">
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{Binding [McpTraffic.Tool], Source={x:Static local:LanguageManager.Instance}}" Width="110" DisplayMemberBinding="{Binding Tool}" />
                        <GridViewColumn Header="{Binding [McpTraffic.Tag], Source={x:Static local:LanguageManager.Instance}}" Width="70" DisplayMemberBinding="{Binding Tag}" />
                        <GridViewColumn Header="{Binding [McpTraffic.Payload], Source={x:Static local:LanguageManager.Instance}}" Width="390" DisplayMemberBinding="{Binding Payload}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</Window>