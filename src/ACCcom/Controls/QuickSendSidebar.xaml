<UserControl x:Class="ACCcom.Controls.QuickSendSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ACCcom.Controls"
             xmlns:local="clr-namespace:ACCcom">

    <UserControl.Resources>
        <!-- Icon button for page navigation -->
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource HeaderButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <!-- Command row: flat full-width button -->
        <Style x:Key="CommandRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="8,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <controls:PaintedCard Background="{DynamicResource BgSurfaceBrush}" CornerRadius="8"
            Effect="{DynamicResource CardShadow}" Margin="0,6,8,4">
        <Grid Margin="6,5,6,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Row 0: Title ===== -->
            <DockPanel Grid.Row="0" Margin="4,0,2,6">
                <TextBlock DockPanel.Dock="Left" Text="{Binding [Label.QuickSend], Source={x:Static local:LanguageManager.Instance}}"
                           Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           ToolTip="{Binding [Tip.QuickSendArea], Source={x:Static local:LanguageManager.Instance}}" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding PageIndicator}" FontFamily="Consolas" FontSize="10"
                           Foreground="{DynamicResource InkTertiaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </DockPanel>

            <!-- ===== Row 1: Page navigation ===== -->
            <DockPanel Grid.Row="1" Margin="2,0,2,6">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="&#xE72B;" Style="{StaticResource NavButton}" FontFamily="Segoe MDL2 Assets"
                            Command="{Binding PrevPageCommand}"
                            ToolTip="{Binding [QuickSend.PrevPage], Source={x:Static local:LanguageManager.Instance}}" />
                    <ComboBox x:Name="PageSelector" Width="90" Margin="4,0" FontSize="11"
                              ItemsSource="{Binding Pages}"
                              SelectedItem="{Binding CurrentPage}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="&#xE72A;" Style="{StaticResource NavButton}" FontFamily="Segoe MDL2 Assets"
                            Command="{Binding NextPageCommand}"
                            ToolTip="{Binding [QuickSend.NextPage], Source={x:Static local:LanguageManager.Instance}}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#xE710;" Style="{StaticResource NavButton}" FontFamily="Segoe MDL2 Assets"
                            Command="{Binding AddPageCommand}"
                            ToolTip="{Binding [QuickSend.AddPage], Source={x:Static local:LanguageManager.Instance}}" />
                    <Button Content="&#xE712;" Style="{StaticResource NavButton}" Margin="3,0,0,0" FontFamily="Segoe MDL2 Assets"
                            ToolTip="{Binding [QuickSend.PageMenu], Source={x:Static local:LanguageManager.Instance}}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding [QuickSend.RenamePage], Source={x:Static local:LanguageManager.Instance}}"
                                          Click="RenamePage_Click" />
                                <MenuItem Header="{Binding [QuickSend.ExportCurrent], Source={x:Static local:LanguageManager.Instance}}"
                                          Command="{Binding PlacementTarget.DataContext.ExportCurrentPageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="{Binding [QuickSend.DeletePage], Source={x:Static local:LanguageManager.Instance}}"
                                          Command="{Binding PlacementTarget.DataContext.DeletePageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- ===== Row 2: Search filter ===== -->
            <DockPanel Grid.Row="2" Margin="2,0,2,6" LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource InkTertiaryBrush}" Margin="0,0,4,0" />
                <Button DockPanel.Dock="Right" Content="&#xE711;" Margin="2,0,0,0" FontFamily="Segoe MDL2 Assets"
                        Click="ClearFilter_Click"
                        ToolTip="{Binding [QuickSend.ClearFilter], Source={x:Static local:LanguageManager.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource HeaderButton}">
                            <Setter Property="Width" Value="20" />
                            <Setter Property="Height" Value="20" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBox x:Name="QuickSendFilterBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="11" Padding="6,2" VerticalContentAlignment="Center"
                         Background="{DynamicResource BgElevatedBrush}"
                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                         ToolTip="{Binding [QuickSend.FilterByName], Source={x:Static local:LanguageManager.Instance}}" />
            </DockPanel>

            <!-- ===== Row 3: Command list ===== -->
            <ListBox Grid.Row="3" x:Name="CommandsList"
                     ItemsSource="{Binding VisibleCommands}"
                     AlternationCount="1000000"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     Background="Transparent" BorderThickness="0"
                     SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CommandRowButton}"
                                Command="{Binding DataContext.SendShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                MouseLeftButtonDown="CommandRow_MouseDown">
                            <Button.ToolTip>
                                <ToolTip>
                                    <TextBlock Text="{Binding Command}" />
                                </ToolTip>
                            </Button.ToolTip>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding [QuickSend.Send], Source={x:Static local:LanguageManager.Instance}}"
                                              Tag="{Binding}" Click="QuickSendSend_Click" />
                                    <MenuItem Header="{Binding [QuickSend.LoadToSendBox], Source={x:Static local:LanguageManager.Instance}}"
                                              Tag="{Binding}" Click="QuickSendLoad_Click" />
                                    <MenuItem Header="{Binding [QuickSend.CopyCommand], Source={x:Static local:LanguageManager.Instance}}"
                                              Tag="{Binding}" Click="QuickSendCopy_Click" />
                                    <Separator />
                                    <MenuItem Header="{Binding [QuickSend.ToggleHex], Source={x:Static local:LanguageManager.Instance}}"
                                              Tag="{Binding}" Click="QuickSendToggleHex_Click" />
                                    <MenuItem Header="{Binding [QuickSend.Edit], Source={x:Static local:LanguageManager.Instance}}"
                                              Tag="{Binding}" Click="QuickSendEdit_Click" InputGestureText="DblClick" />
                                    <MenuItem Header="{Binding [QuickSend.Delete], Source={x:Static local:LanguageManager.Instance}}"
                                              Tag="{Binding}" Click="QuickSendDelete_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- HEX/TXT indicator dot -->
                                <Rectangle Grid.Column="0" Width="7" Height="7" RadiusX="3.5" RadiusY="3.5"
                                           VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Fill" Value="{DynamicResource StatusBlueBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHex}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource StatusWarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11.5"
                                           Foreground="{DynamicResource InkPrimaryBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource HotkeyIndex}}"
                                           FontSize="9" FontFamily="Consolas"
                                           Foreground="{DynamicResource InkTertiaryBrush}"
                                           VerticalAlignment="Center" Margin="6,0,0,0" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ===== Row 4: Footer actions ===== -->
            <DockPanel Grid.Row="4" Margin="2,6,2,0">
                <Button DockPanel.Dock="Left" Content="{Binding [QuickSend.AddCommand], Source={x:Static local:LanguageManager.Instance}}"
                        Style="{StaticResource OutlineButton}" FontSize="11" Padding="8,0" Height="24"
                        Command="{Binding AddShortcutCommand}"
                        ToolTip="{Binding [Tip.AddQuickCommand], Source={x:Static local:LanguageManager.Instance}}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding [QuickSend.Import], Source={x:Static local:LanguageManager.Instance}}"
                            Style="{StaticResource OutlineButton}" FontSize="11" Padding="8,0" Height="24"
                            Command="{Binding ImportCommand}" />
                    <Button Content="{Binding [QuickSend.ExportAll], Source={x:Static local:LanguageManager.Instance}}"
                            Style="{StaticResource OutlineButton}" FontSize="11" Padding="8,0" Height="24" Margin="4,0,0,0"
                            Command="{Binding ExportAllCommand}" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </controls:PaintedCard>
</UserControl>
