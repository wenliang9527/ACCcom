<UserControl x:Class="ACCcom.Controls.ConnectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ACCcom">

    <!-- Toolbar line 1: mode / serial-or-network / preset / parser / actions.
         Every label+control pair is an atomic horizontal group so a wrap never
         splits "波特率" from its combo. The outer WrapPanel reflows groups onto
         extra rows when the window (or the right-side buttons) squeeze the strip. -->
    <UserControl.Resources>
        <!-- One field = label + control on one line; never breaks across rows. -->
        <Style x:Key="FieldGroup" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,6" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- BasedOn the implicit ComboBox style is load-bearing, not optional: a
             keyed style REPLACES the implicit one wholesale, so without this the
             themed ControlTemplate is dropped and every dropdown falls back to
             the stock Aero chrome — white fill, black text, which is invisible
             in the light theme and glaring in all five dark ones. -->
        <Style x:Key="FieldCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Icon-only button. Carries the MDL2 font itself so callers can put a
             private-use glyph straight in Content: HeaderButton sets Segoe UI,
             and a U+E7xx/E8xx codepoint outside Segoe MDL2 Assets renders as a
             tofu box. -->
        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource HeaderButton}">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyIcons}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </UserControl.Resources>

    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

        <!-- ===== Mode ===== -->
        <StackPanel Style="{StaticResource FieldGroup}">
            <TextBlock Text="{Binding [Label.Mode], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding ConnectionTypes}" SelectedItem="{Binding SelectedConnectionType}"
                      Width="72" Style="{StaticResource FieldCombo}" />
        </StackPanel>

        <!-- ===== Serial connection fields ===== -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedConnectionType}" Value="Serial">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <StackPanel Style="{StaticResource FieldGroup}">
                <TextBlock Text="{Binding [Label.Port], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding PortOptions}"
                          SelectedValuePath="Name" SelectedValue="{Binding SelectedPort, UpdateSourceTrigger=PropertyChanged}"
                          Width="150" IsEditable="False" Style="{StaticResource FieldCombo}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Display}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Style="{StaticResource FieldGroup}">
                <TextBlock Text="{Binding [Label.BaudRate], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaudRate}"
                          Width="84" Style="{StaticResource FieldCombo}" />
                <Button Command="{Binding AutoDetectBaudCommand}"
                        Style="{StaticResource IconBtn}"
                        ToolTip="{Binding [Tip.AutoDetectBaud], Source={x:Static local:LanguageManager.Instance}}">
                    <TextBlock Text="{Binding DetectGlyph, FallbackValue='&#xE721;'}" FontFamily="{StaticResource FontFamilyIcons}" FontSize="{StaticResource FontSizeTitle}" />
                </Button>
            </StackPanel>

            <StackPanel Style="{StaticResource FieldGroup}">
                <TextBlock Text="{Binding [Label.DataBits], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding DataBitsList}" SelectedItem="{Binding SelectedDataBits}"
                          Width="48" Style="{StaticResource FieldCombo}" />
            </StackPanel>

            <StackPanel Style="{StaticResource FieldGroup}">
                <TextBlock Text="{Binding [Label.StopBits], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding StopBitsList}" SelectedIndex="{Binding SelectedStopBits}"
                          Width="72" Style="{StaticResource FieldCombo}" />
            </StackPanel>

            <StackPanel Style="{StaticResource FieldGroup}">
                <TextBlock Text="{Binding [Label.Parity], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding ParityList}" SelectedIndex="{Binding SelectedParity}"
                          Width="72" Style="{StaticResource FieldCombo}" />
            </StackPanel>
        </StackPanel>

        <!-- ===== Network connection fields ===== -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedConnectionType}" Value="TCP">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedConnectionType}" Value="UDP">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <StackPanel Style="{StaticResource FieldGroup}">
                <TextBlock Text="{Binding [Label.Host], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding NetworkHost, UpdateSourceTrigger=PropertyChanged}"
                         Width="140" FontSize="{StaticResource FontSizeBody}" Padding="4,2" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Style="{StaticResource FieldGroup}">
                <TextBlock Text="{Binding [Label.NetworkPort], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding NetworkPort, UpdateSourceTrigger=PropertyChanged}"
                         Width="55" FontSize="{StaticResource FontSizeBody}" Padding="4,2" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- ===== Presets (atomic group) ===== -->
        <StackPanel Style="{StaticResource FieldGroup}">
            <Rectangle Style="{StaticResource ToolSeparator}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding [Label.Preset], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                      DisplayMemberPath="Name" Width="100" Style="{StaticResource FieldCombo}"
                      ToolTip="{Binding [Tip.PresetApply], Source={x:Static local:LanguageManager.Instance}}" />
            <Button Content="&#xE74E;" Command="{Binding SavePresetCommand}" Style="{StaticResource IconBtn}"
                    ToolTip="{Binding [Tip.SavePreset], Source={x:Static local:LanguageManager.Instance}}" />
            <Button Content="&#xE74D;" Command="{Binding DeletePresetCommand}" CommandParameter="{Binding SelectedPreset}"
                    Style="{StaticResource IconBtn}" Margin="0"
                    ToolTip="{Binding [Tip.DeletePreset], Source={x:Static local:LanguageManager.Instance}}" />
        </StackPanel>

        <!-- ===== Parser (atomic group) ===== -->
        <StackPanel Style="{StaticResource FieldGroup}">
            <TextBlock Text="{Binding [Label.Parser], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding AvailableParsers}" SelectedItem="{Binding SelectedParser, Mode=TwoWay}"
                      Width="110" IsEditable="False" Style="{StaticResource FieldCombo}" />
            <Button Content="&#xE838;" Command="{Binding OpenParserDirCommand}" Style="{StaticResource IconBtn}"
                    ToolTip="{Binding [Tip.OpenParserDir], Source={x:Static local:LanguageManager.Instance}}" />
            <Button Content="&#xE70F;" Command="{Binding OpenFrameAssemblerConfigCommand}" Style="{StaticResource IconBtn}" Margin="0"
                    ToolTip="{Binding [Tip.FrameAssemblyConfig], Source={x:Static local:LanguageManager.Instance}}" />
        </StackPanel>
    </WrapPanel>
</UserControl>
