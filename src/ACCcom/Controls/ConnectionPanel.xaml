<UserControl x:Class="ACCcom.Controls.ConnectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ACCcom">

    <!-- Toolbar line 1 (left): mode / serial-or-network fields / parser -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

        <TextBlock Text="{Binding [Label.Mode], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,4,0" />
        <ComboBox ItemsSource="{Binding ConnectionTypes}" SelectedItem="{Binding SelectedConnectionType}"
                  Width="68" Margin="0,0,12,0" />

        <!-- Serial fields: visible when SelectedConnectionType == "Serial" -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedConnectionType}" Value="Serial">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="{Binding [Label.Port], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,4,0" />
            <ComboBox ItemsSource="{Binding AvailablePorts}" Text="{Binding SelectedPort, UpdateSourceTrigger=PropertyChanged}"
                      Width="100" IsEditable="True" Margin="0,0,10,0" />
            <TextBlock Text="{Binding [Label.BaudRate], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,4,0" />
            <ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaudRate}" Width="88" Margin="0,0,4,0" />
            <!-- Auto-detect baud rate by probing common rates against the
                 selected port. Disabled while a probe is running or when the
                 port is already open. Clicking again mid-probe cancels it. -->
            <Button Command="{Binding AutoDetectBaudCommand}"
                    Style="{StaticResource HeaderButton}" FontSize="12" Padding="4,1" VerticalAlignment="Center"
                    ToolTip="{Binding [Tip.AutoDetectBaud], Source={x:Static local:LanguageManager.Instance}}">
                <TextBlock Text="{Binding DetectGlyph, FallbackValue='&#xE721;'}" FontFamily="Segoe MDL2 Assets" FontSize="14" />
            </Button>

            <!-- Connection presets: save current params, one-click restore -->
            <Rectangle Style="{StaticResource ToolSeparator}" Margin="8,0" />
            <TextBlock Text="{Binding [Label.Preset], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,4,0" />
            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                      DisplayMemberPath="Name" Width="110" Margin="0,0,4,0"
                      ToolTip="{Binding [Tip.PresetApply], Source={x:Static local:LanguageManager.Instance}}" />
            <Button Content="&#xE74E;" Command="{Binding SavePresetCommand}"
                    Style="{StaticResource HeaderButton}" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="3,1" VerticalAlignment="Center"
                    ToolTip="{Binding [Tip.SavePreset], Source={x:Static local:LanguageManager.Instance}}" />
            <Button Content="&#xE74D;" Command="{Binding DeletePresetCommand}"
                    CommandParameter="{Binding SelectedPreset}"
                    Style="{StaticResource HeaderButton}" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="3,1" VerticalAlignment="Center"
                    Margin="2,0,0,0"
                    ToolTip="{Binding [Tip.DeletePreset], Source={x:Static local:LanguageManager.Instance}}" />
        </StackPanel>

        <!-- Network fields: visible when SelectedConnectionType != "Serial" -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedConnectionType}" Value="TCP">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedConnectionType}" Value="UDP">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="{Binding [Label.Host], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,4,0" />
            <TextBox Text="{Binding NetworkHost, UpdateSourceTrigger=PropertyChanged}"
                     Width="140" FontSize="11" Padding="4,1" Margin="0,0,8,0" />
            <TextBlock Text="{Binding [Label.NetworkPort], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,4,0" />
            <TextBox Text="{Binding NetworkPort, UpdateSourceTrigger=PropertyChanged}"
                     Width="55" FontSize="11" Padding="4,1" Margin="0,0,12,0" />
        </StackPanel>

        <Rectangle Style="{StaticResource ToolSeparator}" />

        <!-- Parser selection -->
        <TextBlock Text="{Binding [Label.Parser], Source={x:Static local:LanguageManager.Instance}}" Style="{StaticResource Label}" Margin="0,0,4,0" />
        <ComboBox ItemsSource="{Binding AvailableParsers}"
                  SelectedItem="{Binding SelectedParser, Mode=TwoWay}"
                  Width="110" IsEditable="False" Margin="0,0,4,0" />
        <Button Content="&#xE838;" Command="{Binding OpenParserDirCommand}"
                Style="{StaticResource HeaderButton}" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="3,1" VerticalAlignment="Center"
                ToolTip="{Binding [Tip.OpenParserDir], Source={x:Static local:LanguageManager.Instance}}" />
        <Button Content="&#xE70F;" Command="{Binding OpenFrameAssemblerConfigCommand}"
                Style="{StaticResource HeaderButton}" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="3,1" VerticalAlignment="Center"
                ToolTip="{Binding [Tip.FrameAssemblyConfig], Source={x:Static local:LanguageManager.Instance}}" />
    </StackPanel>
</UserControl>
