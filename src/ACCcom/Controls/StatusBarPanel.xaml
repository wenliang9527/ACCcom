<UserControl x:Class="ACCcom.Controls.StatusBarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ACCcom">

    <StatusBar Padding="10,2">
        <StatusBarItem>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Margin="0,0,6,0" ToolTip="连接状态指示灯（绿=已连接，灰=未连接）">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource InkTertiaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource StatusGreenBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}" FontSize="11"
                          Foreground="{DynamicResource InkSecondaryBrush}"
                          ToolTip="操作状态/最近消息（双击清空）" />
            </StackPanel>
        </StatusBarItem>

        <!-- 分隔符 1：连接指示与计数器 -->
        <Separator Width="1" Height="12" Margin="8,0"
                   Background="{DynamicResource DividerBrush}" />

        <!-- RX 计数块（点击重置） -->
        <StatusBarItem>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock FontSize="10" FontFamily="Consolas" Cursor="Hand"
                           ToolTip="点击重置全部计数器（RX/TX/Errors/统计）"
                           MouseLeftButtonUp="OnCounterClick"
                           TextDecorations="Underline">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="RX " Foreground="{DynamicResource StatusBlueBrush}" FontWeight="SemiBold" />
                    <Run Text="{Binding RxByteCount, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text=" B" Foreground="{DynamicResource InkTertiaryBrush}" />
                </TextBlock>
                <TextBlock Text="{Binding RxRate}" FontSize="9" FontFamily="Consolas"
                           Foreground="{DynamicResource InkTertiaryBrush}"
                           ToolTip="近 5 秒 RX 吞吐（字节/秒 | 帧/秒）" />
            </StackPanel>
        </StatusBarItem>

        <!-- 分隔符 2 -->
        <Separator Width="1" Height="12" Margin="6,0"
                   Background="{DynamicResource DividerBrush}" />

        <!-- TX 计数块（点击重置） -->
        <StatusBarItem>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock FontSize="10" FontFamily="Consolas" Cursor="Hand"
                           ToolTip="点击重置全部计数器"
                           MouseLeftButtonUp="OnCounterClick"
                           TextDecorations="Underline">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="TX " Foreground="{DynamicResource StatusGreenBrush}" FontWeight="SemiBold" />
                    <Run Text="{Binding TxByteCount, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text=" B" Foreground="{DynamicResource InkTertiaryBrush}" />
                </TextBlock>
                <TextBlock Text="{Binding TxRate}" FontSize="9" FontFamily="Consolas"
                           Foreground="{DynamicResource InkTertiaryBrush}"
                           ToolTip="近 5 秒 TX 吞吐（字节/秒 | 帧/秒）" />
            </StackPanel>
        </StatusBarItem>

        <!-- 分隔符 3 -->
        <Separator Width="1" Height="12" Margin="6,0"
                   Background="{DynamicResource DividerBrush}" />

        <!-- 错误帧计数（点击重置） -->
        <StatusBarItem>
            <TextBlock FontSize="10" FontFamily="Consolas" Cursor="Hand"
                       ToolTip="错误帧数。点击重置全部计数器"
                       MouseLeftButtonUp="OnCounterClick"
                       TextDecorations="Underline">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="Err " FontWeight="SemiBold" />
                <Run Text="{Binding ErrorFrameCount, Mode=OneWay}" Foreground="{DynamicResource RedErrorBrush}" FontWeight="Bold" />
            </TextBlock>
        </StatusBarItem>

        <!-- 分隔符 4 -->
        <Separator Width="1" Height="12" Margin="6,0"
                   Background="{DynamicResource DividerBrush}" />

<!-- 连接时长（无点击行为，纯显示） -->
        <StatusBarItem>
            <TextBlock Text="{Binding ConnectionDuration}" FontSize="10" FontFamily="Consolas"
                       ToolTip="连接持续时长"
                       Foreground="{DynamicResource InkSecondaryBrush}">
                <Run Text="Up " Foreground="{DynamicResource InkTertiaryBrush}" FontWeight="SemiBold" />
                <Run Text="{Binding ConnectionDuration, Mode=OneWay}" FontWeight="Bold" />
            </TextBlock>
        </StatusBarItem>

        <!-- 分隔符 5 -->
        <Separator Width="1" Height="12" Margin="6,0"
                   Background="{DynamicResource DividerBrush}" />

        <!-- 录制指示（点击切换录制开关）。隐藏整个控件以避免占用状态栏空间。 -->
        <StatusBarItem>
            <StatusBarItem.Style>
                <Style TargetType="StatusBarItem">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StatusBarItem.Style>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Background="Transparent" MouseLeftButtonUp="OnRecordingClick"
                        ToolTip="{Binding RecordingFile}">
                <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{DynamicResource RedErrorBrush}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <!-- 简单的"呼吸"动画：用 RenderTransform 做透明度脉冲 -->
                                <Trigger Property="IsVisible" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1.0" To="0.4" Duration="0:0:0.8"
                                                                 AutoReverse="True" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource RedErrorBrush}" FontWeight="SemiBold">
                    <Run Text="REC " />
                    <Run Text="{Binding RecordedCount, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </StatusBarItem>

        <!-- 弹性空间 -->
        <StatusBarItem HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x2753;" FontSize="12" Cursor="Hand" Margin="0,0,8,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource InkTertiaryBrush}"
                           ToolTip="{Binding [Shortcuts.Title], Source={x:Static local:LanguageManager.Instance}}"
                           MouseLeftButtonDown="OnShortcutsClick">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource InkTertiaryBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding HttpUrl}" FontSize="10" Cursor="Hand"
                           Foreground="{DynamicResource InkTertiaryBrush}"
                           ToolTip="HTTP API 监听地址（用于外部程序/AI 集成）"
                           MouseLeftButtonDown="OnHttpUrlClick" />
            </StackPanel>
        </StatusBarItem>
    </StatusBar>
</UserControl>
