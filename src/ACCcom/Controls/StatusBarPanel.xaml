<UserControl x:Class="ACCcom.Controls.StatusBarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ACCcom">

    <!--
        Instrument readout, one line.

        It used to be a two-line stack per counter (bytes on top, rate below) with
        six 1px separators between seven fields. Units ("B", "B/s", "fps") were set
        at the same size and weight as the numbers they measure, so a glance could
        not separate "0 B" from "0.0 B/s". Now: label is an engraved MicroLabel,
        the number is a ValueText (mono, semibold), and every unit and rate is a
        recessive UnitText. Separators are spaced by gap, so the eye groups
        {RX TX} as traffic and {ERR UP BUF} as session state.
    -->
    <StatusBar Padding="10,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- ── Connection state (click clears the status message) ── -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand"
                        MouseLeftButtonUp="OnStatusClearClick"
                        ToolTip="{Binding [StatusBar.StatusText], Source={x:Static local:LanguageManager.Instance}}">
                <Ellipse x:Name="ConnDot" Width="6" Height="6" Margin="0,0,7,0"
                         ToolTip="{Binding [StatusBar.ConnectionIndicator], Source={x:Static local:LanguageManager.Instance}}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource InkTertiaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource StatusGreenBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource UnitText}"
                           FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- ── Traffic ── -->
            <Rectangle Style="{StaticResource StatusDivider}" />

            <!-- RX -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand"
                        MouseLeftButtonUp="OnCounterClick"
                        ToolTip="{Binding [StatusBar.ResetCounters], Source={x:Static local:LanguageManager.Instance}}">
                <TextBlock Text="{Binding [StatusBar.RxLabel], Mode=OneWay, Source={x:Static local:LanguageManager.Instance}}"
                           Style="{StaticResource MicroLabel}" Margin="0,0,5,0" />
                <TextBlock Text="{Binding RxByteCount, Mode=OneWay}" Style="{StaticResource ValueText}" />
                <TextBlock Text="B" Style="{StaticResource UnitText}" Margin="3,0,9,0" />
                <TextBlock Text="{Binding RxRate, Mode=OneWay}" Style="{StaticResource UnitText}"
                           ToolTip="{Binding [StatusBar.RxThroughput], Source={x:Static local:LanguageManager.Instance}}" />
            </StackPanel>

            <Rectangle Style="{StaticResource StatusDivider}" />

            <!-- TX -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand"
                        MouseLeftButtonUp="OnCounterClick"
                        ToolTip="{Binding [StatusBar.ResetCounters], Source={x:Static local:LanguageManager.Instance}}">
                <TextBlock Text="{Binding [StatusBar.TxLabel], Mode=OneWay, Source={x:Static local:LanguageManager.Instance}}"
                           Style="{StaticResource MicroLabel}" Margin="0,0,5,0" />
                <TextBlock Text="{Binding TxByteCount, Mode=OneWay}" Style="{StaticResource ValueText}" />
                <TextBlock Text="B" Style="{StaticResource UnitText}" Margin="3,0,9,0" />
                <TextBlock Text="{Binding TxRate, Mode=OneWay}" Style="{StaticResource UnitText}"
                           ToolTip="{Binding [StatusBar.TxThroughput], Source={x:Static local:LanguageManager.Instance}}" />
            </StackPanel>

            <!-- ── Session state ── -->
            <Rectangle Style="{StaticResource StatusDivider}" />

            <!-- Error frames (click resets) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand"
                        MouseLeftButtonUp="OnCounterClick"
                        ToolTip="{Binding [StatusBar.Errors], Source={x:Static local:LanguageManager.Instance}}">
                <TextBlock Text="{Binding [StatusBar.ErrLabel], Mode=OneWay, Source={x:Static local:LanguageManager.Instance}}"
                           Style="{StaticResource MicroLabel}" Margin="0,0,5,0" />
                <TextBlock Text="{Binding ErrorFrameCount, Mode=OneWay}" Style="{StaticResource ValueText}"
                           Foreground="{DynamicResource RedErrorBrush}" />
            </StackPanel>

            <Rectangle Style="{StaticResource StatusDivider}" />

            <!-- Uptime. TextBlock with Run children only: binding both Text and a
                 Run renders the duration twice. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        ToolTip="{Binding [StatusBar.Uptime], Source={x:Static local:LanguageManager.Instance}}">
                <TextBlock Text="{Binding [StatusBar.UpLabel], Mode=OneWay, Source={x:Static local:LanguageManager.Instance}}"
                           Style="{StaticResource MicroLabel}" Margin="0,0,5,0" />
                <TextBlock Style="{StaticResource ValueText}">
                    <TextBlock.Text>
                        <Binding Path="ConnectionDuration" Mode="OneWay" />
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>

            <Rectangle Style="{StaticResource StatusDivider}" />

            <!-- Ring buffer occupancy (read-only, 1Hz) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        ToolTip="{Binding [StatusBar.BufferUsage], Source={x:Static local:LanguageManager.Instance}}">
                <TextBlock Text="{Binding [StatusBar.BufLabel], Mode=OneWay, Source={x:Static local:LanguageManager.Instance}}"
                           Style="{StaticResource MicroLabel}" Margin="0,0,5,0" />
                <TextBlock Text="{Binding BufferUsageText, Mode=OneWay}" Style="{StaticResource ValueText}" />
            </StackPanel>

            <!-- ── Recording (only while recording, so it must not reserve space) ── -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Background="Transparent" Cursor="Hand"
                        MouseLeftButtonUp="OnRecordingClick"
                        ToolTip="{Binding RecordingFile}"
                        Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding [Menu.OpenRecordingsFolder], Source={x:Static local:LanguageManager.Instance}}"
                                  Click="OnOpenRecordingsFolder_Click" />
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <Ellipse x:Name="RecDot" Width="7" Height="7" Margin="0,0,6,0"
                         Fill="{DynamicResource RedErrorBrush}"
                         VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource RedErrorBrush}" />
                            <!-- Recording pulse. This earns its motion: a recording
                                 dot that sits still reads as decoration. Kept slow
                                 and smoothly eased so it stays peripheral instead of
                                 strobing, and it is the only looping animation left
                                 in the chrome. -->
                            <Style.Triggers>
                                <Trigger Property="IsVisible" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1.0" To="0.4"
                                                                 Duration="{StaticResource MotionSlow}"
                                                                 AutoReverse="True">
                                                    <DoubleAnimation.EasingFunction>
                                                        <SineEase EasingMode="EaseInOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding [StatusBar.RecLabel], Mode=OneWay, Source={x:Static local:LanguageManager.Instance}}"
                           Style="{StaticResource MicroLabel}" Margin="0,0,5,0" />
                <TextBlock Text="{Binding RecordedCount, Mode=OneWay}" Style="{StaticResource ValueText}" />
            </StackPanel>

            <!-- ── Right side ── -->
            <Grid HorizontalAlignment="Right" Margin="16,0,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ShortcutsHint" Text="&#xE897;"
                               FontFamily="{StaticResource FontFamilyIcons}"
                               FontSize="{StaticResource FontSizeBody}" Cursor="Hand"
                               Margin="0,0,10,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource InkTertiaryBrush}"
                               MouseLeftButtonDown="OnShortcutsClick"
                               ToolTip="{Binding [Shortcuts.Title], Source={x:Static local:LanguageManager.Instance}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource InkTertiaryBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding HttpUrl}" Style="{StaticResource UnitText}"
                               FontSize="{StaticResource FontSizeBody}" Cursor="Hand"
                               ToolTip="{Binding [StatusBar.HttpUrl], Source={x:Static local:LanguageManager.Instance}}"
                               MouseLeftButtonDown="OnHttpUrlClick" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </StatusBar>
</UserControl>
