<UserControl x:Class="ACCcom.Controls.ToolBarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ACCcom">

    <!-- Toolbar line 2 (left): views / rx-tx display / advanced toggles -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

        <Button Content="{Binding [Button.Diff], Source={x:Static local:LanguageManager.Instance}}" Command="{Binding CompareFramesCommand}"
                Style="{StaticResource OutlineButton}" Margin="0,0,5,0"
                ToolTip="{Binding [Tip.HexDiffCompare], Source={x:Static local:LanguageManager.Instance}}" />
        <Button Content="{Binding [Button.Plot], Source={x:Static local:LanguageManager.Instance}}" Command="{Binding OpenPlotCommand}"
                Style="{StaticResource OutlineButton}" Margin="0,0,5,0"
                ToolTip="{Binding [Tip.OpenRealtimePlot], Source={x:Static local:LanguageManager.Instance}}" />
        <Button Content="{Binding [Button.Stats], Source={x:Static local:LanguageManager.Instance}}" Command="{Binding OpenStatsCommand}"
                Style="{StaticResource OutlineButton}" Margin="0,0,5,0"
                ToolTip="{Binding [Tip.OpenDataStats], Source={x:Static local:LanguageManager.Instance}}" />
        <Button Content="{Binding [Button.Modbus], Source={x:Static local:LanguageManager.Instance}}" Command="{Binding OpenModbusCommand}"
                Style="{StaticResource OutlineButton}" Margin="0,0,0,0"
                ToolTip="{Binding [Tip.ModbusMaster], Source={x:Static local:LanguageManager.Instance}}" />

        <Rectangle Style="{StaticResource ToolSeparator}" />

        <CheckBox Content="{Binding [Check.ShowRX], Source={x:Static local:LanguageManager.Instance}}" IsChecked="{Binding ShowRx}"
                  Foreground="{DynamicResource StatusBlueBrush}" FontSize="11" />
        <CheckBox Content="{Binding [Check.ShowTX], Source={x:Static local:LanguageManager.Instance}}" IsChecked="{Binding ShowTx}"
                  Foreground="{DynamicResource InkSecondaryBrush}" FontSize="11" Margin="8,0,0,0" />

        <Rectangle Style="{StaticResource ToolSeparator}" />

        <ToggleButton x:Name="AdvancedToggle" Style="{StaticResource ToolToggle}" IsChecked="{Binding ShowAdvanced}"
                      ToolTip="{Binding [Tip.AdvancedParams], Source={x:Static local:LanguageManager.Instance}}">
            <TextBlock Text="&#x2699;" />
        </ToggleButton>

        <ToggleButton Style="{StaticResource ToolToggle}" Margin="4,0,0,0"
                      IsChecked="{Binding ShowQuickSendSidebar}"
                      ToolTip="{Binding [QuickSend.Toggle], Source={x:Static local:LanguageManager.Instance}}">
            <TextBlock Text="&#x2630;" />
        </ToggleButton>
    </StackPanel>
</UserControl>
